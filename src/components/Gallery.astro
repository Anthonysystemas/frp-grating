---
interface ImageItem {
  src: string;
  alt: string;
  hoverColor?: string; // e.g. "hover:shadow-blue-500/20"
}

interface Props {
  tagline?: string;
  titleNormal?: string;
  titleHighlight?: string;
  description?: string;
  images?: ImageItem[];
}

// Valores por defecto (si no se pasan props, carga los datos de FRP)
const {
  tagline = "Galería de producto · Fibras FRP",
  titleNormal = "REJILLAS",
  titleHighlight = "FRP",
  description = "Fibra de vidrio de alta resistencia para minería, industria y construcción.",
  images = [
    { src: "/images/rejillas1.jpg", alt: "Rejilla FRP", hoverColor: "hover:shadow-blue-500/20" },
    { src: "/images/rejillas2.jpg", alt: "Rejilla FRP", hoverColor: "hover:shadow-amber-500/20" },
    { src: "/images/rejillas3.jpg", alt: "Rejilla FRP", hoverColor: "hover:shadow-cyan-500/20" },
    { src: "/images/rejillas4.jpg", alt: "Rejilla FRP", hoverColor: "hover:shadow-blue-500/20" },
  ]
} = Astro.props;
---

<section id="galeria" class="relative w-full bg-[#0A0E1A] py-24 px-6 overflow-hidden border-b border-slate-900/50">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(#3B82F6 1px, transparent 1px), linear-gradient(90deg, #3B82F6 1px, transparent 1px); background-size: 48px 48px;"
  ></div>

  <div class="max-w-7xl mx-auto px-4 py-8">

    <!-- 1. ENCABEZADO CENTRADO -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="flex items-center justify-center gap-2 mb-3">
        <span class="w-8 h-0.5 bg-blue-500 inline-block"></span>
        <span class="text-xs uppercase tracking-widest text-blue-400 font-semibold">
          {tagline}
        </span>
      </div>

      <h2 class="text-4xl md:text-5xl font-black text-white tracking-tight">
        {titleNormal} <br class="md:hidden" />
        <span class="text-blue-500">{titleHighlight}</span>
      </h2>

      <p class="mt-4 text-slate-400 text-lg">
        {description}
      </p>
    </div>

    <!-- 2. GRID DE IMÁGENES DINÁMICO -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {images.map((img) => (
        <div class={`group relative overflow-hidden rounded-lg bg-[#0D1220] border border-slate-800/40 transition-all duration-300 hover:shadow-lg ${img.hoverColor || 'hover:shadow-blue-500/20'} cursor-pointer aspect-square`}>
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/30 group-hover:bg-black/10 transition-all duration-300"></div>
        </div>
      ))}
    </div>

  </div>
</section>