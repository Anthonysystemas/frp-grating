<dialog
  id="nueva-modal"
  aria-labelledby="nueva-title"
  class="m-auto max-h-[92vh] w-[calc(100vw-1rem)] max-w-3xl overflow-hidden rounded-2xl border border-slate-700 bg-[#0B1120] p-0 text-slate-100 shadow-2xl shadow-black/60 backdrop:bg-black/80 sm:w-[calc(100vw-2rem)]"
>
  <div class="flex max-h-[92vh] flex-col">
    <!-- Cabecera -->
    <div class="flex shrink-0 items-start justify-between gap-3 border-b border-slate-800 px-4 py-4 sm:px-6">
      <div class="min-w-0">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-blue-400">Desde cero</p>
        <h2 id="nueva-title" class="mt-0.5 truncate text-base font-bold text-white sm:text-lg">
          Nueva cotización
        </h2>
        <p class="mt-1 text-xs text-slate-400 sm:text-sm">
          Completa los datos del cliente y agrega productos del catálogo oficial.
        </p>
      </div>
      <button
        id="nueva-close"
        type="button"
        class="-m-1 shrink-0 rounded-lg p-1 text-slate-400 transition hover:bg-slate-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
        aria-label="Cerrar nueva cotización"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="nueva-form" class="min-h-0 flex-1 overflow-y-auto" novalidate>
      <div class="space-y-4 px-4 py-4 sm:px-6 sm:py-5">
        <!-- Bloque 1: cliente -->
        <section class="rounded-xl border border-slate-800 bg-[#070B14]/60 p-3 sm:p-4">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Datos del cliente</p>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="text-xs text-slate-400">Nombre</span>
              <input id="nueva-nombre" type="text" autocomplete="name" placeholder="Cliente manual" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
              <span class="mt-1 block text-[11px] text-slate-500">Si lo dejas vacío se usará Cliente manual</span>
            </label>
            <label class="block">
              <span class="text-xs text-slate-400">Empresa</span>
              <input id="nueva-empresa" type="text" autocomplete="organization" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
            </label>
            <label class="block">
              <span class="text-xs text-slate-400">RUC / DNI</span>
              <input id="nueva-ruc" type="text" inputmode="numeric" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
            </label>
            <label class="block">
              <span class="text-xs text-slate-400">Correo</span>
              <input id="nueva-correo" type="email" autocomplete="email" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
            </label>
            <label class="block">
              <span class="text-xs text-slate-400">Celular</span>
              <input id="nueva-telefono" type="tel" inputmode="tel" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
            </label>
            <label class="block">
              <span class="text-xs text-slate-400">Ciudad</span>
              <input id="nueva-ciudad" type="text" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
            </label>
          </div>
        </section>

        <!-- Bloque 2: productos del catálogo -->
        <section class="rounded-xl border border-slate-800 bg-[#070B14]/60 p-3 sm:p-4">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Productos del catálogo</p>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="text-xs text-slate-400">Tipo de producto</span>
              <select id="nueva-catalog-category" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-2.5 py-2.5 text-sm text-white focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"></select>
            </label>
            <label class="block">
              <span class="text-xs text-slate-400">Modelo / medida</span>
              <select id="nueva-catalog-product" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-2.5 py-2.5 text-sm text-white focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"></select>
            </label>
          </div>
          <div class="mt-3 flex flex-wrap items-end gap-2">
            <label class="block w-20">
              <span class="text-xs text-slate-400">Cantidad</span>
              <input id="nueva-catalog-qty" type="number" min="1" step="1" inputmode="numeric" value="1" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-2 py-2 text-center font-mono text-sm text-white focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
            </label>
            <div class="min-w-[8rem] flex-1">
              <span class="text-xs text-slate-400">Precio unitario</span>
              <div id="nueva-catalog-price" class="mt-1.5 rounded-lg border border-slate-800 bg-[#070B14] px-2.5 py-2 text-right font-mono text-sm text-slate-300">US$ 0.00</div>
            </div>
            <button
              id="nueva-catalog-add"
              type="button"
              class="rounded-lg border border-blue-500/40 bg-blue-500/10 px-4 py-2.5 text-xs font-bold text-blue-300 transition hover:bg-blue-500/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            >
              Agregar
            </button>
          </div>

          <div id="nueva-items" class="mt-3 space-y-3"></div>

          <p
            id="nueva-items-empty"
            class="mt-3 rounded-lg border border-dashed border-slate-700 bg-[#0B1120] px-3 py-4 text-center text-xs text-slate-400"
          >
            Aún no hay productos. Selecciona uno del catálogo y pulsa “Agregar”.
          </p>

          <div id="nueva-total-wrap" class="mt-4 hidden space-y-1.5 border-t border-slate-700 pt-3">
            <div class="flex items-center justify-between text-sm text-slate-400">
              <span>Subtotal</span>
              <span id="nueva-subtotal" class="font-mono text-slate-200">US$ 0.00</span>
            </div>
            <div class="flex items-center justify-between text-sm text-slate-400">
              <span>IGV (18%)</span>
              <span id="nueva-igv" class="font-mono text-slate-200">US$ 0.00</span>
            </div>
            <div class="flex items-center justify-between border-t border-slate-800 pt-1.5">
              <span class="text-sm font-semibold text-slate-300">Total</span>
              <strong id="nueva-total" class="font-mono text-base font-black text-emerald-400">US$ 0.00</strong>
            </div>
          </div>
        </section>

        <p id="nueva-error" class="hidden break-words rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-300" role="alert"></p>
      </div>

      <!-- Acciones -->
      <div class="sticky bottom-0 flex flex-col-reverse gap-2 border-t border-slate-800 bg-[#0B1120]/95 px-4 py-3 backdrop-blur sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <button
          id="nueva-cancel"
          type="button"
          class="rounded-lg border border-slate-700 bg-transparent px-4 py-2.5 text-sm font-semibold text-slate-300 transition hover:border-slate-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
        >
          Cancelar
        </button>
        <button
          id="nueva-create"
          type="button"
          disabled
          class="rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Crear Cotización Pendiente
        </button>
      </div>
    </form>
  </div>
</dialog>
