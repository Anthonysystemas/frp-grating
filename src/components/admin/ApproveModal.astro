<dialog
  id="approve-modal"
  aria-labelledby="approve-title"
  class="m-auto max-h-[92vh] w-[calc(100vw-1rem)] max-w-3xl overflow-hidden rounded-2xl border border-slate-700 bg-[#0B1120] p-0 text-slate-100 shadow-2xl shadow-black/60 backdrop:bg-black/80 sm:w-[calc(100vw-2rem)]"
>
  <div class="flex max-h-[92vh] flex-col">
    <!-- Cabecera del modal -->
    <div class="flex shrink-0 items-start justify-between gap-3 border-b border-slate-800 px-4 py-4 sm:px-6">
      <div class="min-w-0">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-blue-400">Aprobación</p>
        <h2 id="approve-title" class="mt-0.5 truncate font-mono text-base font-bold text-white sm:text-lg">
          Cotización
        </h2>
        <p id="modal-client" class="mt-1 truncate text-xs text-slate-400 sm:text-sm"></p>
      </div>
      <button
        id="modal-close"
        type="button"
        class="-m-1 shrink-0 rounded-lg p-1 text-slate-400 transition hover:bg-slate-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
        aria-label="Cerrar modal"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Vista editable -->
    <form id="approve-form" class="min-h-0 flex-1 overflow-y-auto" novalidate>
      <div id="modal-form-view" class="px-4 py-4 sm:px-6 sm:py-5">
        <div class="rounded-xl border border-slate-800 bg-[#070B14]/60 p-3 sm:p-4">
          <div class="flex items-center justify-between gap-3">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Ítems de la cotización</p>
            <p class="text-[11px] text-slate-500">Edita precios o elimina</p>
          </div>
          <div id="modal-items" class="mt-3 space-y-3"></div>
          <p
            id="modal-items-empty"
            class="mt-3 hidden rounded-lg border border-dashed border-slate-700 bg-[#0B1120] px-3 py-4 text-center text-xs text-slate-400"
          >
            No hay ítems en esta cotización. Agrega al menos uno para poder aprobarla.
          </p>

          <button
            id="toggle-catalog"
            type="button"
            aria-expanded="false"
            aria-controls="catalog-panel"
            class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-dashed border-slate-700 bg-transparent px-4 py-2.5 text-sm font-semibold text-blue-300 transition hover:border-blue-500 hover:bg-blue-500/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" d="M12 5v14M5 12h14"></path>
            </svg>
            Agregar ítem / producto
          </button>

          <div
            id="catalog-panel"
            class="mt-3 hidden rounded-lg border border-slate-700 bg-[#0B1120] p-3 sm:p-4"
          >
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <label class="block">
                <span class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Tipo de producto</span>
                <select
                  id="catalog-category"
                  class="mt-1 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                ></select>
              </label>
              <label class="block">
                <span class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Medida / modelo</span>
                <select
                  id="catalog-product"
                  class="mt-1 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                ></select>
              </label>
            </div>

            <div class="mt-3 flex flex-wrap items-end gap-2">
              <label class="w-20">
                <span class="block text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Cant.</span>
                <input
                  id="catalog-qty"
                  type="number"
                  min="1"
                  step="1"
                  inputmode="numeric"
                  value="1"
                  class="mt-1 w-full rounded-lg border border-slate-700 bg-[#070B14] px-2 py-2.5 text-center font-mono text-sm text-white outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
                />
              </label>

              <label class="min-w-[8.5rem] flex-1">
                <span class="block text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Precio unitario</span>
                <div class="mt-1 flex items-center rounded-lg border border-slate-700 bg-[#070B14] focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20">
                  <span class="pl-2.5 text-xs font-semibold text-slate-500">US$</span>
                  <input
                    id="catalog-price"
                    type="number"
                    min="0"
                    step="0.01"
                    inputmode="decimal"
                    value="0.00"
                    class="w-full bg-transparent px-2 py-2.5 text-right font-mono text-sm text-white outline-none"
                  />
                </div>
              </label>

              <button
                id="catalog-add"
                type="button"
                class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 sm:w-auto"
              >
                Agregar
              </button>
            </div>

            <p class="mt-2 text-[11px] leading-relaxed text-slate-500">
              El precio sugerido viene del catálogo oficial y puede ajustarse antes de agregarlo.
            </p>
          </div>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <label class="block">
            <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Flete (US$)</span>
            <input
              id="modal-flete"
              type="number"
              min="0"
              step="0.01"
              inputmode="decimal"
              value="0"
              class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
            />
          </label>

          <div class="rounded-xl border border-slate-800 bg-[#070B14]/60 p-3">
            <dl class="space-y-1.5 text-sm">
              <div class="flex items-center justify-between gap-3">
                <dt class="text-slate-400">Subtotal</dt>
                <dd id="modal-subtotal" class="font-mono font-semibold text-slate-200">US$ 0.00</dd>
              </div>
              <div class="flex items-center justify-between gap-3">
                <dt class="text-slate-400">IGV (18%)</dt>
                <dd id="modal-igv" class="font-mono font-semibold text-slate-200">US$ 0.00</dd>
              </div>
              <div class="flex items-center justify-between gap-3">
                <dt class="text-slate-400">Flete</dt>
                <dd id="modal-flete-label" class="font-mono font-semibold text-slate-200">US$ 0.00</dd>
              </div>
              <div class="flex items-center justify-between gap-3 border-t border-slate-700 pt-2">
                <dt class="font-bold text-white">Total</dt>
                <dd id="modal-total" class="font-mono text-base font-black text-blue-400">US$ 0.00</dd>
              </div>
            </dl>
          </div>
        </div>

        <div class="mt-4 rounded-xl border border-slate-800 bg-[#070B14]/60 p-3 sm:p-4">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Datos del administrador</p>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="block">
              <span class="text-xs text-slate-400">Nombre</span>
              <input
                id="modal-admin-name"
                type="text"
                autocomplete="name"
                placeholder="Ej. Anthony Ramírez"
                class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
              />
            </label>
            <label class="block">
              <span class="text-xs text-slate-400">Correo</span>
              <input
                id="modal-admin-email"
                type="email"
                autocomplete="email"
                placeholder="admin@maskelperu.com"
                class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
              />
            </label>
          </div>
        </div>

        <p id="modal-error" class="mt-4 hidden break-words rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-300" role="alert"></p>
      </div>

      <div class="sticky bottom-0 flex flex-col-reverse gap-2 border-t border-slate-800 bg-[#0B1120]/95 px-4 py-3 backdrop-blur sm:flex-row sm:justify-end sm:px-6">
        <button
          id="modal-cancel"
          type="button"
          class="rounded-lg border border-slate-700 bg-transparent px-4 py-2.5 text-sm font-semibold text-slate-300 transition hover:border-slate-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
        >
          Cancelar
        </button>
        <button
          id="modal-submit"
          type="submit"
          class="rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 disabled:cursor-wait disabled:opacity-60"
        >
          Aprobar cotización
        </button>
      </div>
    </form>

    <!-- Vista de éxito -->
    <div id="modal-success" class="hidden px-4 py-10 text-center sm:px-8">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-400">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"></path>
        </svg>
      </div>
      <h3 class="mt-4 text-lg font-bold text-white">Cotización aprobada</h3>
      <p id="modal-success-detail" class="mt-1 text-sm text-slate-400"></p>

      <a
        id="download-pdf"
        href="#"
        download
        class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-emerald-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400 sm:w-auto"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16"></path>
        </svg>
        Descargar PDF oficial
      </a>

      <button
        id="success-close"
        type="button"
        class="mt-3 block w-full rounded-lg border border-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-300 transition hover:border-slate-600 hover:text-white sm:mx-auto sm:w-auto"
      >
        Cerrar
      </button>
    </div>
  </div>
</dialog>
