<dialog
  id="import-modal"
  aria-labelledby="import-title"
  class="m-auto max-h-[92vh] w-[calc(100vw-1rem)] max-w-3xl overflow-hidden rounded-2xl border border-slate-700 bg-[#0B1120] p-0 text-slate-100 shadow-2xl shadow-black/60 backdrop:bg-black/80 sm:w-[calc(100vw-2rem)]"
>
  <div class="flex max-h-[92vh] flex-col">
    <!-- Cabecera -->
    <div class="flex shrink-0 items-start justify-between gap-3 border-b border-slate-800 px-4 py-4 sm:px-6">
      <div class="min-w-0">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-emerald-400">WhatsApp</p>
        <h2 id="import-title" class="mt-0.5 truncate text-base font-bold text-white sm:text-lg">
          Importar desde WhatsApp
        </h2>
        <p class="mt-1 text-xs text-slate-400 sm:text-sm">
          Pega el mensaje completo. Solo se crearán ítems que coincidan con el catálogo oficial.
        </p>
      </div>
      <button
        id="import-close"
        type="button"
        class="-m-1 shrink-0 rounded-lg p-1 text-slate-400 transition hover:bg-slate-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
        aria-label="Cerrar importación"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="import-form" class="min-h-0 flex-1 overflow-y-auto" novalidate>
      <div class="px-4 py-4 sm:px-6 sm:py-5">
        <!-- Paso 1: pegar texto -->
        <div id="import-step-paste">
          <label for="import-text" class="block text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
            Mensaje de WhatsApp
          </label>
          <textarea
            id="import-text"
            rows="10"
            spellcheck="false"
            placeholder="Pega aquí el mensaje del cliente…"
            class="mt-2 w-full resize-y rounded-xl border border-slate-700 bg-[#070B14] px-3 py-3 font-mono text-sm leading-relaxed text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
          ></textarea>
          <p class="mt-2 text-[11px] leading-relaxed text-slate-500">
            Formato del panel: “Código: MSK-…” y líneas “- Producto (detalle) xN”. También se acepta texto libre con
            medidas (1000x3000, 1.22x2.44), espesores (25/38 mm), modelos PT02 y clips.
          </p>
          <p id="import-paste-error" class="mt-2 hidden break-words rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-300" role="alert"></p>
        </div>

        <!-- Paso 2: vista previa -->
        <div id="import-step-review" hidden>
          <section class="rounded-xl border border-slate-800 bg-[#070B14]/60 p-3 sm:p-4">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Datos del cliente</p>
            <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
              <label class="block">
                <span class="text-xs text-slate-400">Nombre</span>
                <input id="import-nombre" type="text" autocomplete="name" placeholder="Cliente WhatsApp" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
              </label>
              <label class="block">
                <span class="text-xs text-slate-400">Empresa</span>
                <input id="import-empresa" type="text" autocomplete="organization" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
              </label>
              <label class="block">
                <span class="text-xs text-slate-400">RUC / DNI</span>
                <input id="import-ruc" type="text" inputmode="numeric" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
              </label>
              <label class="block">
                <span class="text-xs text-slate-400">Correo</span>
                <input id="import-correo" type="email" autocomplete="email" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
              </label>
              <label class="block">
                <span class="text-xs text-slate-400">Celular</span>
                <input id="import-telefono" type="tel" inputmode="tel" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
              </label>
              <label class="block">
                <span class="text-xs text-slate-400">Ciudad</span>
                <input id="import-ciudad" type="text" class="mt-1.5 w-full rounded-lg border border-slate-700 bg-[#070B14] px-3 py-2.5 text-sm text-white placeholder:text-slate-600 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
              </label>
            </div>
          </section>

          <section class="mt-4 rounded-xl border border-slate-800 bg-[#070B14]/60 p-3 sm:p-4">
            <div class="flex items-center justify-between gap-3">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Productos detectados</p>
              <p class="text-[11px] text-slate-500">Solo catálogo oficial</p>
            </div>

            <div id="import-items" class="mt-3 space-y-3"></div>

            <div
              id="import-items-empty"
              class="mt-3 rounded-lg border border-dashed border-slate-700 bg-[#0B1120] px-3 py-4 text-center"
            >
              <p class="text-xs text-slate-400">
                No se detectaron productos del catálogo. Revisa el texto o crea la cotización desde cero.
              </p>
              <button
                id="import-create-manual"
                type="button"
                class="mt-3 inline-flex items-center justify-center rounded-lg border border-slate-600 bg-slate-800/60 px-3 py-2 text-xs font-semibold text-slate-200 transition hover:border-slate-500 hover:bg-slate-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
              >
                Crear cotización desde cero
              </button>
            </div>

            <div id="import-total-wrap" class="mt-4 hidden space-y-1.5 border-t border-slate-700 pt-3">
              <div class="flex items-center justify-between text-sm text-slate-400">
                <span>Subtotal</span>
                <span id="import-subtotal" class="font-mono text-slate-200">US$ 0.00</span>
              </div>
              <div class="flex items-center justify-between text-sm text-slate-400">
                <span>IGV (18%)</span>
                <span id="import-igv" class="font-mono text-slate-200">US$ 0.00</span>
              </div>
              <div class="flex items-center justify-between border-t border-slate-800 pt-1.5">
                <span class="text-sm font-semibold text-slate-300">Total</span>
                <strong id="import-total" class="font-mono text-base font-black text-emerald-400">US$ 0.00</strong>
              </div>
            </div>
          </section>

          <section id="import-leftover-wrap" class="mt-4 hidden rounded-xl border border-amber-500/20 bg-amber-500/5 p-3 sm:p-4">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-300">Texto no reconocido</p>
            <p class="mt-1 text-[11px] text-amber-200/70">
              Estas líneas no coinciden con el catálogo oficial. No se crearán ítems manuales.
            </p>
            <pre id="import-leftover" class="mt-2 max-h-40 overflow-y-auto whitespace-pre-wrap break-words rounded-lg bg-[#070B14] p-2 text-xs text-slate-300"></pre>
          </section>

          <p id="import-error" class="mt-4 hidden break-words rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-300" role="alert"></p>
        </div>
      </div>

      <!-- Acciones -->
      <div class="sticky bottom-0 flex flex-col-reverse gap-2 border-t border-slate-800 bg-[#0B1120]/95 px-4 py-3 backdrop-blur sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <button
          id="import-cancel"
          type="button"
          class="rounded-lg border border-slate-700 bg-transparent px-4 py-2.5 text-sm font-semibold text-slate-300 transition hover:border-slate-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
        >
          Cancelar
        </button>

        <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center">
          <button
            id="import-back"
            type="button"
            hidden
            class="rounded-lg border border-slate-700 bg-transparent px-4 py-2.5 text-sm font-semibold text-slate-300 transition hover:border-slate-600 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          >
            Volver a pegar
          </button>
          <button
            id="import-analyze"
            type="button"
            class="rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
          >
            Analizar Texto
          </button>
          <button
            id="import-create"
            type="button"
            disabled
            hidden
            class="rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400 disabled:cursor-not-allowed disabled:opacity-50"
          >
            Crear Cotización Pendiente
          </button>
        </div>
      </div>
    </form>
  </div>
</dialog>
