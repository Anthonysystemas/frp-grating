<div id="loading" class="mt-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" aria-live="polite">
  <div class="h-52 animate-pulse rounded-xl border border-slate-800/80 bg-[#0B1120]/70"></div>
  <div class="h-52 animate-pulse rounded-xl border border-slate-800/80 bg-[#0B1120]/70"></div>
  <div class="h-52 animate-pulse rounded-xl border border-slate-800/80 bg-[#0B1120]/70"></div>
  <div class="h-52 animate-pulse rounded-xl border border-slate-800/80 bg-[#0B1120]/70"></div>
</div>

<div
  id="error-state"
  class="mt-8 hidden rounded-2xl border border-red-500/30 bg-red-500/5 p-6 text-center"
  role="alert"
>
  <p class="text-sm font-semibold text-red-300" id="error-message">
    No se pudieron cargar las cotizaciones.
  </p>
  <button
    id="retry"
    type="button"
    class="mt-4 rounded-lg bg-red-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-red-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-400"
  >
    Reintentar
  </button>
</div>

<div
  id="empty-state"
  class="mt-8 hidden rounded-2xl border border-slate-800 bg-[#0B1120]/70 p-8 text-center"
>
  <p class="text-base font-bold text-white">Sin cotizaciones para mostrar</p>
  <p class="mt-1 text-sm text-slate-400" id="empty-detail">
    Cuando se genere una cotización desde la web aparecerá aquí.
  </p>
</div>
