<section class="mt-5 flex flex-col gap-3 sm:mt-6">
  <!-- Fila superior: acciones principales + buscador -->
  <div class="flex flex-col gap-2 lg:flex-row lg:items-center">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
      <button
        id="nueva-open"
        type="button"
        class="inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 sm:w-auto sm:text-sm"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M12 5v14M5 12h14" />
        </svg>
        Nueva cotización
      </button>

      <button
        id="import-open"
        type="button"
        class="inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2.5 text-xs font-bold text-emerald-400 transition hover:bg-emerald-500/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400 sm:w-auto sm:text-sm"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.16c-.25.69-1.46 1.32-2.02 1.4-.52.08-1.17.11-1.89-.12-.44-.14-1-.32-1.72-.63-3.03-1.31-5.01-4.36-5.16-4.57-.15-.2-1.24-1.65-1.24-3.15 0-1.5.78-2.23 1.06-2.54.28-.31.61-.39.81-.39.2 0 .41 0 .58.01.19.01.44-.07.68.52.25.61.86 2.11.94 2.26.08.15.13.33.03.53-.1.2-.15.33-.3.51-.15.18-.32.4-.46.54-.15.15-.31.31-.13.61.18.3.79 1.3 1.7 2.11 1.17 1.04 2.16 1.36 2.46 1.51.3.15.47.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.68-.15.28.1 1.78.84 2.08.99.3.15.5.23.58.36.08.13.08.75-.17 1.44Z" />
        </svg>
        Importar WhatsApp
      </button>
    </div>

    <label class="relative block w-full lg:ml-auto lg:max-w-xl">
      <span class="sr-only">Buscar cotizaciones</span>
      <svg
        class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path stroke-linecap="round" d="m21 21-4.35-4.35"></path>
      </svg>
      <input
        id="search"
        type="search"
        autocomplete="off"
        placeholder="Buscar código, cliente, empresa, RUC o correo…"
        class="w-full rounded-lg border border-slate-700 bg-[#0B1120] py-2.5 pl-9 pr-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
      />
    </label>
  </div>

  <!-- Fila inferior: filtros de estado -->
  <div
    id="filters"
    class="flex w-full items-center gap-1 overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/60 p-1"
    role="group"
    aria-label="Filtrar por estado"
  >
    <button
      type="button"
      data-filter="pendiente_revision"
      aria-pressed="true"
      class="group shrink-0 rounded-lg px-3 py-2 text-xs font-semibold text-slate-400 transition hover:text-white aria-pressed:bg-blue-600 aria-pressed:text-white sm:text-sm"
    >
      Pendientes
      <span data-count="pendiente_revision" class="ml-1 inline-flex min-w-5 items-center justify-center rounded-full bg-slate-800 px-1.5 py-0.5 text-[10px] font-bold text-slate-400 group-aria-pressed:bg-white/20 group-aria-pressed:text-white">(0)</span>
    </button>
    <button
      type="button"
      data-filter="aprobada"
      aria-pressed="false"
      class="group shrink-0 rounded-lg px-3 py-2 text-xs font-semibold text-slate-400 transition hover:text-white aria-pressed:bg-blue-600 aria-pressed:text-white sm:text-sm"
    >
      Aprobadas
      <span data-count="aprobada" class="ml-1 inline-flex min-w-5 items-center justify-center rounded-full bg-slate-800 px-1.5 py-0.5 text-[10px] font-bold text-slate-400 group-aria-pressed:bg-white/20 group-aria-pressed:text-white">(0)</span>
    </button>
    <button
      type="button"
      data-filter="historial"
      aria-pressed="false"
      class="group shrink-0 rounded-lg px-3 py-2 text-xs font-semibold text-slate-400 transition hover:text-white aria-pressed:bg-blue-600 aria-pressed:text-white sm:text-sm"
    >
      Pagadas
      <span data-count="historial" class="ml-1 inline-flex min-w-5 items-center justify-center rounded-full bg-slate-800 px-1.5 py-0.5 text-[10px] font-bold text-slate-400 group-aria-pressed:bg-white/20 group-aria-pressed:text-white">(0)</span>
    </button>
    <button
      type="button"
      data-filter="eliminada"
      aria-pressed="false"
      class="group shrink-0 rounded-lg px-3 py-2 text-xs font-semibold text-slate-400 transition hover:text-white aria-pressed:bg-blue-600 aria-pressed:text-white sm:text-sm"
    >
      Papelera
      <span data-count="eliminada" class="ml-1 inline-flex min-w-5 items-center justify-center rounded-full bg-slate-800 px-1.5 py-0.5 text-[10px] font-bold text-slate-400 group-aria-pressed:bg-white/20 group-aria-pressed:text-white">(0)</span>
    </button>
  </div>
</section>
