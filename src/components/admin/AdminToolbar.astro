<section class="mt-5 flex flex-col gap-3 sm:mt-6 sm:flex-row sm:items-center sm:justify-between">
  <div id="filters" class="flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filtrar por estado">
    <button
      type="button"
      data-filter="todas"
      aria-pressed="true"
      class="shrink-0 rounded-lg border border-slate-700 bg-[#0B1120] px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-slate-600 hover:text-white aria-pressed:border-blue-500 aria-pressed:bg-blue-600 aria-pressed:text-white sm:text-sm"
    >
      Todas
    </button>
    <button
      type="button"
      data-filter="pendiente_revision"
      aria-pressed="false"
      class="shrink-0 rounded-lg border border-slate-700 bg-[#0B1120] px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-slate-600 hover:text-white aria-pressed:border-blue-500 aria-pressed:bg-blue-600 aria-pressed:text-white sm:text-sm"
    >
      Pendientes
    </button>
    <button
      type="button"
      data-filter="aprobada"
      aria-pressed="false"
      class="shrink-0 rounded-lg border border-slate-700 bg-[#0B1120] px-3 py-2 text-xs font-semibold text-slate-300 transition hover:border-slate-600 hover:text-white aria-pressed:border-blue-500 aria-pressed:bg-blue-600 aria-pressed:text-white sm:text-sm"
    >
      Aprobadas
    </button>
  </div>

  <label class="relative block w-full sm:max-w-xs">
    <span class="sr-only">Buscar cotizaciones</span>
    <svg
      class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path stroke-linecap="round" d="m21 21-4.35-4.35"></path>
    </svg>
    <input
      id="search"
      type="search"
      autocomplete="off"
      placeholder="Buscar código, cliente, RUC o correo…"
      class="w-full rounded-lg border border-slate-700 bg-[#0B1120] py-2.5 pl-9 pr-3 text-sm text-white placeholder:text-slate-500 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
    />
  </label>
</section>
