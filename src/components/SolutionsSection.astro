---
// src/components/SolutionsSection.astro
---

<section id="soluciones" class="relative w-full bg-[#0A0E1A] py-20 px-4 sm:px-6 border-b border-slate-900/50">
  <div class="max-w-7xl mx-auto">
    
    <!-- ENCABEZADO -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="flex items-center justify-center gap-2 mb-3">
        <span class="w-8 h-[2px] bg-blue-500 inline-block"></span>
        <span class="text-xs uppercase tracking-widest text-blue-400 font-semibold">
          Catálogo Industrial
        </span>
      </div>

      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
        Nuestras <span class="text-blue-500">Soluciones</span>
      </h2>

      <p class="mt-4 text-slate-400 text-sm sm:text-base">
        Sistemas estructurales de alta resistencia diseñados para minería, industria y construcción.
      </p>
    </div>

    <!-- GRID DE SOLUCIONES (4 LÍNEAS DE PRODUCTO) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- 1. GRATING FRP -->
      <div class="bg-[#0D1220] border border-slate-800/80 rounded-xl p-6 flex flex-col justify-between hover:border-blue-500/50 transition-all duration-300 group">
        <div>
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/30 rounded-lg flex items-center justify-center mb-4 text-blue-400 group-hover:bg-blue-500 group-hover:text-white transition-all">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Grating FRP</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Rejillas de fibra de vidrio moldeadas y pultruidas. Anticorrosivas, dieléctricas y de bajo mantenimiento.
          </p>
        </div>
        <a href="/grating-frp" class="text-xs font-bold text-blue-400 hover:text-blue-300 flex items-center gap-1 mt-2">
          Ver detalles →
        </a>
      </div>

      <!-- 2. GRATING METÁLICO -->
      <div class="bg-[#0D1220] border border-slate-800/80 rounded-xl p-6 flex flex-col justify-between hover:border-blue-500/50 transition-all duration-300 group">
        <div>
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/30 rounded-lg flex items-center justify-center mb-4 text-blue-400 group-hover:bg-blue-500 group-hover:text-white transition-all">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Grating Metálico</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Rejillas de acero electroforjado y galvanizado en caliente para alta carga estructural en pasarelas y plantas.
          </p>
        </div>
        <a href="/grating-metalico" class="text-xs font-bold text-blue-400 hover:text-blue-300 flex items-center gap-1 mt-2">
          Ver detalles →
        </a>
      </div>

      <!-- 3. PELDAÑOS -->
      <div class="bg-[#0D1220] border border-slate-800/80 rounded-xl p-6 flex flex-col justify-between hover:border-blue-500/50 transition-all duration-300 group">
        <div>
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/30 rounded-lg flex items-center justify-center mb-4 text-blue-400 group-hover:bg-blue-500 group-hover:text-white transition-all">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Peldaños Metálicos</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Peldaños antideslizantes a medida (lisos o dentados) con fijación mediante tornillos para escaleras de emergencia e industriales.
          </p>
        </div>
        <a href="/peldanos" class="text-xs font-bold text-blue-400 hover:text-blue-300 flex items-center gap-1 mt-2">
          Ver detalles →
        </a>
      </div>

      <!-- 4. CANALETAS -->
      <div class="bg-[#0D1220] border border-slate-800/80 rounded-xl p-6 flex flex-col justify-between hover:border-blue-500/50 transition-all duration-300 group">
        <div>
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/30 rounded-lg flex items-center justify-center mb-4 text-blue-400 group-hover:bg-blue-500 group-hover:text-white transition-all">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2m-4-1v8m0 0l3-3m-3 3L9 8"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Canaletas de Drenaje</h3>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Sistemas de canaletas con cubierta de rejilla para canalización de fluidos y evacuación en plantas industriales y drenaje vial.
          </p>
        </div>
        <a href="/canaletas" class="text-xs font-bold text-blue-400 hover:text-blue-300 flex items-center gap-1 mt-2">
          Ver detalles →
        </a>
      </div>

    </div>

  </div>
</section>