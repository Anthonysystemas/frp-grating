---
// src/components/Simulator.astro — Cotizador de stock fijo (importación B2B)
---

<section
    id="simulator"
    class="relative w-full bg-[#0E1728] py-24 px-6 overflow-hidden border-b border-slate-900/50"
>
    <!-- Grid de fondo, igual que el resto del sitio -->
    <div
        class="pointer-events-none absolute inset-0 opacity-[0.04]"
        style="background-image: linear-gradient(#3B82F6 1px, transparent 1px), linear-gradient(90deg, #3B82F6 1px, transparent 1px); background-size: 48px 48px;"
    >
    </div>

    <div class="relative max-w-3xl mx-auto mb-14 text-center flex flex-col items-center">
        <div class="flex items-center gap-3 mb-4 justify-center">
            <span class="h-px w-8 bg-blue-500"></span>
            <span
                class="text-blue-500 text-sm font-bold tracking-widest uppercase"
            >
                Cotizador de stock
            </span>
             <span class="h-px w-8 bg-blue-500"></span>
        </div>
        <h2
            class="text-4xl md:text-6xl font-black text-white leading-[1.05] mb-6"
        >
            COTIZA NUESTRO<br />
            <span class="text-blue-500">STOCK DISPONIBLE</span>
        </h2>
        <p class="text-slate-400 text-lg max-w-xl leading-relaxed">
            Selecciona los productos de nuestro stock de importación, indica la cantidad de unidades o paneles y obtén un precio estimado al instante. Descuento automático del 5% en pedidos desde $1,000 USD.
        </p>
    </div>

    <div
        class="relative max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-6 items-start"
    >
        <!-- Formulario -->
        <div
            class="md:col-span-7 bg-[#0D1220] border border-slate-800/40 rounded-2xl p-6 md:p-8"
        >
            <form id="simulador-form" class="space-y-6">
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 gap-6 pb-6 border-b border-slate-800/30"
                >
                    <div class="flex flex-col gap-2">
                        <label
                            for="cliente-nombre"
                            class="text-sm font-mono uppercase tracking-widest text-slate-200"
                        >
                            Nombre completo *
                        </label>
                        <input
                            type="text"
                            id="cliente-nombre"
                            placeholder="Juan Pérez"
                            class="w-full bg-[#070A13] border border-slate-800/50 rounded-lg px-4 py-3 text-sm text-white placeholder:text-slate-600 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/30 transition-all"
                            required
                        />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label
                            for="cliente-empresa"
                            class="text-sm font-mono uppercase tracking-widest text-slate-200"
                        >
                            Empresa *
                        </label>
                        <input
                            type="text"
                            id="cliente-empresa"
                            placeholder="Mi Empresa S.A.C."
                            class="w-full bg-[#070A13] border border-slate-800/50 rounded-lg px-4 py-3 text-sm text-white placeholder:text-slate-600 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/30 transition-all"
                            required
                        />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label
                            for="cliente-ruc"
                            class="text-sm font-mono uppercase tracking-widest text-slate-200"
                        >
                            RUC *
                        </label>
                        <input
                            type="text"
                            id="cliente-ruc"
                            placeholder="20123456789"
                            class="w-full bg-[#070A13] border border-slate-800/50 rounded-lg px-4 py-3 text-sm text-white placeholder:text-slate-600 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/30 transition-all"
                            required
                        />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label
                            for="cliente-correo"
                            class="text-sm font-mono uppercase tracking-widest text-slate-200"
                        >
                            Correo Electronico *
                        </label>
                        <input
                            type="email"
                            id="cliente-correo"
                            placeholder="juan.perez@miempresa.com"
                            class="w-full bg-[#070A13] border border-slate-800/50 rounded-lg px-4 py-3 text-sm text-white placeholder:text-slate-600 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/30 transition-all"
                            required
                        />
                    </div>
                </div>

                <div class="flex flex-col gap-4">
                    <label
                        class="text-sm font-mono uppercase tracking-widest text-slate-200"
                    >
                        Productos en stock *
                    </label>

                    <div
                        id="contenedor-filas"
                        class="space-y-3 border-b border-slate-800/30 pb-6"
                    >
                        <!-- Las filas se generan dinámicamente desde CATALOGO_PRODUCTOS -->
                    </div>

                    <button
                        type="button"
                        id="btn-add-producto"
                        class="self-start text-xs font-bold text-blue-400 hover:text-blue-300 flex items-center gap-1.5 py-2 transition-colors"
                    >
                        <svg
                            class="w-3.5 h-3.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 4v16m8-8H4"></path>
                        </svg>
                        Añadir otro producto
                    </button>
                </div>

                <button
                    type="button"
                    id="btn-calcular"
                    class="w-full bg-blue-600 hover:bg-blue-500 text-white font-black uppercase tracking-wider py-4 rounded-lg transition-colors text-sm flex items-center justify-center gap-2 mt-4"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 7h6m-6 4h6m-6 4h3M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z"
                        ></path>
                    </svg>
                    Calcular presupuesto
                </button>
            </form>
        </div>

        <!-- Resultado + WhatsApp -->
        <div class="md:col-span-5 flex flex-col gap-4">
            <div
                id="resultado-box"
                class="bg-[#0D1220] border border-dashed border-slate-800/50 rounded-2xl p-8 flex flex-col items-center justify-center text-center min-h-70 transition-all duration-300"
            >
                <svg
                    class="w-9 h-9 text-blue-500/30 mb-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9 7h6m-6 4h6m-6 4h3M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z"
                    ></path>
                </svg>
                <p class="text-slate-400 text-sm max-w-xs leading-relaxed">
                    Completa tus datos, añade los productos y pulsa
                    <strong class="text-slate-300 font-semibold inline-block mx-1">
                        Calcular presupuesto
                    </strong>
                    para ver el estimado.
                </p>
            </div>
            <a
                href="https://wa.me/51984649227"
                id="btn-whatsapp-simulador"
                target="_blank"
                rel="noopener noreferrer"
                aria-disabled="true"
                class="w-full bg-transparent border-2 border-green-500/60 text-green-400 font-bold py-4 rounded-lg transition-colors text-sm flex items-center justify-center gap-2 opacity-50 pointer-events-none"
            >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 004.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.84 14.13c-.25.7-1.45 1.34-2 1.43-.51.08-1.15.11-1.86-.12a16.7 16.7 0 01-1.69-.62c-2.98-1.29-4.92-4.3-5.07-4.5-.15-.2-1.21-1.61-1.21-3.07 0-1.46.77-2.18 1.04-2.48.27-.3.6-.37.8-.37.2 0 .4 0 .57.01.18.01.43-.07.67.52.25.6.85 2.07.92 2.22.07.15.12.33.02.53-.1.2-.15.32-.3.49-.15.17-.31.38-.45.51-.15.15-.3.31-.13.61.17.3.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.38 1.47.3.15.48.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.27.1 1.73.82 2.03.97.3.15.5.22.57.35.08.13.08.74-.17 1.44z"
                    ></path>
                </svg>
                Contactar por WhatsApp
            </a>
        </div>
    </div>
</section>
<script>
    function initSimulador() {
        // Guardia anti-doble-inicialización (HMR / View Transitions)
        const w = window as unknown as { __simuladorInit?: boolean };
        if (w.__simuladorInit) return;
        w.__simuladorInit = true;

        // ============================================================
        // ÚNICA FUENTE DE VERDAD (SSOT) — catálogo de stock fijo (JS puro)
        // ============================================================
        const CATALOGO_PRODUCTOS = [
            { id: "frp_grating", nombre: "FRP Grating (Resina Vinilester)", precio: 145 },
            { id: "steel_grating", nombre: "Grating Metálico Dentado (Panel 1000x3000mm)", precio: 185 },
            { id: "m_clips", nombre: "Grapas M (Acero Inox SS 304)", precio: 4.5 },
            { id: "galv_clips", nombre: 'Clips Galvanizados (1/4" x 2")', precio: 2.5 },
        ];

        const MAPA_PRECIOS = Object.fromEntries(
            CATALOGO_PRODUCTOS.map(function (p) { return [p.id, p.precio]; }),
        );

        const MAPA_NOMBRES = Object.fromEntries(
            CATALOGO_PRODUCTOS.map(function (p) { return [p.id, p.nombre]; }),
        );

        // Umbral de descuento por monto (USD, antes del descuento)
        const DISCOUNT_THRESHOLD = 1000;

        const formulario = document.getElementById("simulador-form") as HTMLFormElement | null;
        const btnAddProducto = document.getElementById("btn-add-producto") as HTMLButtonElement | null;
        const contenedorFilas = document.getElementById("contenedor-filas") as HTMLDivElement | null;
        const btnCalcular = document.getElementById("btn-calcular") as HTMLButtonElement | null;
        const resultadoBox = document.getElementById("resultado-box") as HTMLDivElement | null;
        const btnWaSimulador = document.getElementById("btn-whatsapp-simulador") as HTMLAnchorElement | null;

        // Null guards: abortar si falta estructura esencial del DOM
        if (!contenedorFilas) return;
        if (!formulario) return;
        if (!btnCalcular) return;
        if (!resultadoBox) return;

        const filasContainer = contenedorFilas;
        const panelResultado = resultadoBox;

        // Helper: exige un elemento del DOM (tipo no-nulo garantizado)
        function exigir<T extends object>(el: T | null, id: string): T {
            if (!el) throw new Error("Falta el elemento #" + id);
            return el;
        }

        const nombreInput = exigir(document.getElementById("cliente-nombre") as HTMLInputElement | null, "cliente-nombre");
        const empresaInput = exigir(document.getElementById("cliente-empresa") as HTMLInputElement | null, "cliente-empresa");
        const rucInput = exigir(document.getElementById("cliente-ruc") as HTMLInputElement | null, "cliente-ruc");
        const correoInput = exigir(document.getElementById("cliente-correo") as HTMLInputElement | null, "cliente-correo");

        // ---------- Helpers de catálogo ----------
        function poblarSelect(select: HTMLSelectElement, seleccionado: string = "") {
            select.innerHTML = "";
            const placeholder = document.createElement("option");
            placeholder.value = "";
            placeholder.disabled = true;
            placeholder.selected = seleccionado === "";
            placeholder.textContent = "Selecciona un producto...";
            select.appendChild(placeholder);

            CATALOGO_PRODUCTOS.forEach(function (p) {
                const opt = document.createElement("option");
                opt.value = p.id;
                opt.textContent = p.nombre + " — $" + p.precio + " USD";
                if (p.id === seleccionado) opt.selected = true;
                select.appendChild(opt);
            });
        }

        function crearFila() {
            const fila = document.createElement("div");
            fila.className =
                "fila-producto grid grid-cols-1 sm:grid-cols-12 gap-3 items-end";
            fila.innerHTML =
                '<div class="sm:col-span-8 flex flex-col gap-2">' +
                    '<select aria-label="Producto" class="producto-select w-full bg-[#070A13] border border-slate-800/50 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/30 transition-all cursor-pointer"></select>' +
                '</div>' +
                '<div class="sm:col-span-3 flex flex-col gap-2">' +
                    '<input type="number" min="1" step="1" placeholder="Cantidad" aria-label="Cantidad" class="cantidad-input w-full bg-[#070A13] border border-slate-800/50 rounded-lg px-4 py-3 text-sm text-white placeholder:text-slate-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/30 transition-all" required />' +
                '</div>' +
                '<div class="sm:col-span-1">' +
                    '<button type="button" class="btn-eliminar w-full p-3 text-slate-400 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-colors" title="Eliminar fila">' +
                        '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">' +
                            '<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>' +
                        '</svg>' +
                    '</button>' +
                '</div>';
            const select = fila.querySelector<HTMLSelectElement>(".producto-select");
            if (!select) return fila;
            poblarSelect(select);
            return fila;
        }

        // Null-safe: nunca devuelve NaN, devuelve 0 si falta el input
        function leerCantidad(input: HTMLInputElement | null) {
            if (!input || input.value === "" || input.value === null || input.value === undefined) return 0;
            const n = parseInt(input.value, 10);
            return isNaN(n) ? 0 : n;
        }

        function setWaEnabled(enabled: boolean) {
            if (!btnWaSimulador) return;
            btnWaSimulador.setAttribute("aria-disabled", String(!enabled));
            btnWaSimulador.classList.toggle("opacity-50", !enabled);
            btnWaSimulador.classList.toggle("pointer-events-none", !enabled);
            btnWaSimulador.classList.toggle("hover:border-green-500", enabled);
        }

        // El botón solo vive tras un cálculo válido; cualquier cambio lo invalida
        function invalidarCotizacion() {
            setWaEnabled(false);
        }

        // Oculta el botón eliminar cuando solo queda una fila
        function actualizarVisibilidadEliminar() {
            const filas = filasContainer.querySelectorAll(".fila-producto");
            filas.forEach(function (fila) {
                const btn = fila.querySelector(".btn-eliminar");
                if (!btn) return;
                btn.classList.toggle("hidden", filas.length <= 1);
            });
        }

        // ---------- Init: primera fila ----------
        contenedorFilas.appendChild(crearFila());

        window.addEventListener("maskel:select-product", function (event) {
            const productId = (event as CustomEvent<{ productId?: string }>).detail?.productId;
            if (!productId) return;

            const primeraFila = filasContainer.querySelector<HTMLElement>(".fila-producto");
            const select = primeraFila?.querySelector<HTMLSelectElement>(".producto-select");
            if (!select) return;

            select.value = productId;
            select.dispatchEvent(new Event("change", { bubbles: true }));
            document.getElementById("simulator")?.scrollIntoView({ behavior: "smooth", block: "start" });
        });

        function validarEstructuraCorreo(correo: string) {
            const patronCorreo = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return patronCorreo.test(correo);
        }

        function validarDatosCliente() {
            if (
                !nombreInput.value.trim() ||
                !empresaInput.value.trim() ||
                !rucInput.value.trim() ||
                !correoInput.value.trim()
            ) {
                panelResultado.innerHTML = `
                    <span class="text-4xl mb-4">⚠️</span>
                    <p class="text-red-500 text-sm font-bold">Por favor, completa tu Nombre, Empresa, RUC y Correo para utilizar el simulador.</p>
                `;
                panelResultado.className =
                    "bg-red-50/20 border-2 border-dashed border-red-300 rounded-sm p-8 flex flex-col items-center justify-center text-center min-h-[280px] transition-all duration-300";
                return false;
            }
            if (!validarEstructuraCorreo(correoInput.value.trim())) {
                panelResultado.innerHTML = `
                    <span class="text-4xl mb-4">⚠️</span>
                    <p class="text-red-500 text-sm font-bold">Por favor, ingresa un correo electrónico válido.</p>
                `;
                panelResultado.className =
                    "bg-red-50/20 border-2 border-dashed border-red-300 rounded-sm p-8 flex flex-col items-center justify-center text-center min-h-[280px] transition-all duration-300";
                return false;
            }
            return true;
        }

        // Anti-duplicados POR ID (nunca por precio)
        function actualizarOpcionesDeshabilitadas() {
            const filas = filasContainer.querySelectorAll(".fila-producto");
            const idsSeleccionados: string[] = [];
            filas.forEach(function (fila) {
                const sel = fila.querySelector<HTMLSelectElement>(".producto-select");
                if (sel && sel.value && sel.value !== "") idsSeleccionados.push(sel.value);
            });

            filas.forEach(function (fila) {
                const select = fila.querySelector<HTMLSelectElement>(".producto-select");
                if (!select) return;
                const valorActual = select.value;
                Array.from(select.options).forEach(function (option: HTMLOptionElement) {
                    if (option.value === "") return; // placeholder siempre disponible
                    option.disabled =
                        idsSeleccionados.includes(option.value) &&
                        option.value !== valorActual;
                });
            });
        }

        // ============================================================
        // DELEGACIÓN DE EVENTOS — listeners adjuntados UNA sola vez
        // ============================================================
        // Añadir fila (sin fricción: NO valida datos de contacto aquí)
        if (btnAddProducto) btnAddProducto.addEventListener("click", function () {
            const totalFilas = filasContainer.querySelectorAll(".fila-producto").length;
            if (totalFilas >= CATALOGO_PRODUCTOS.length) {
                panelResultado.innerHTML = `
                    <span class="text-4xl mb-4">⚠️</span>
                    <p class="text-red-500 text-sm font-bold">No puedes añadir más de ${CATALOGO_PRODUCTOS.length} productos.</p>
                `;
                panelResultado.className =
                    "bg-red-50/20 border-2 border-dashed border-red-300 rounded-sm p-8 flex flex-col items-center justify-center text-center min-h-[280px] transition-all duration-300";
                return;
            }

            contenedorFilas.appendChild(crearFila());
            actualizarOpcionesDeshabilitadas();
            actualizarVisibilidadEliminar();
            invalidarCotizacion();
        });

        // Delegación: eliminar fila (un solo listener, no uno por botón)
        if (contenedorFilas) contenedorFilas.addEventListener("click", function (e) {
            const target = e.target;
            const btn = target instanceof Element ? target.closest(".btn-eliminar") : null;
            if (!btn) return;
            const filas = filasContainer.querySelectorAll(".fila-producto");
            if (filas.length <= 1) return; // conservar al menos una fila
            const fila = btn.closest(".fila-producto");
            if (fila) fila.remove();
            actualizarOpcionesDeshabilitadas();
            actualizarVisibilidadEliminar();
            invalidarCotizacion();
        });

        // Delegación: cambios en selects e inputs de cantidad
        if (contenedorFilas) contenedorFilas.addEventListener("change", function (e) {
            const target = e.target;
            if (target instanceof Element && target.matches(".producto-select")) {
                actualizarOpcionesDeshabilitadas();
            }
            invalidarCotizacion();
        });
        if (contenedorFilas) contenedorFilas.addEventListener("input", function () {
            invalidarCotizacion();
        });

        // Cualquier cambio en contacto invalida la cotización anterior
        [nombreInput, empresaInput, rucInput, correoInput].forEach(function (input) {
            if (input) input.addEventListener("input", invalidarCotizacion);
        });

        // Guardia: bloquear clic en WhatsApp mientras esté deshabilitado
        if (btnWaSimulador) btnWaSimulador.addEventListener("click", function (e) {
            if (btnWaSimulador.getAttribute("aria-disabled") === "true") {
                e.preventDefault();
            }
        });

        actualizarOpcionesDeshabilitadas();
        actualizarVisibilidadEliminar();
        setWaEnabled(false);

        // ---------- Cálculo (único punto de validación de contacto) ----------
        function ejecutarCalculo() {
            if (!validarDatosCliente()) { invalidarCotizacion(); return; }

            let subtotalGlobal = 0;
            let cantidadUnidadesTotales = 0;
            let hayErrores = false;

            let qtyFrpGrating = 0;
            let qtySteelGrating = 0;
            let qtyMClips = 0;
            let qtyGalvClips = 0;

            const filas = filasContainer.querySelectorAll(".fila-producto");
            if (filas.length === 0) hayErrores = true;

            filas.forEach(function (fila) {
                const select = fila.querySelector<HTMLSelectElement>(".producto-select");
                const input = fila.querySelector<HTMLInputElement>(".cantidad-input");

                const id = select ? select.value : "";
                const precio = id ? MAPA_PRECIOS[id] : undefined;
                const cantidad = leerCantidad(input);

                if (!id || precio === undefined || cantidad <= 0) {
                    hayErrores = true;
                } else {
                    // Total por fila: Precio Unitario × Cantidad
                    subtotalGlobal += precio * cantidad;
                    cantidadUnidadesTotales += cantidad;

                    if (id === "frp_grating") qtyFrpGrating += cantidad;
                    else if (id === "steel_grating") qtySteelGrating += cantidad;
                    else if (id === "m_clips") qtyMClips += cantidad;
                    else if (id === "galv_clips") qtyGalvClips += cantidad;
                }
            });

            if (hayErrores || cantidadUnidadesTotales === 0) {
                panelResultado.innerHTML = `
                    <span class="text-4xl mb-4">⚠️</span>
                    <p class="text-red-500 text-sm font-bold">Por favor, selecciona un producto e ingresa una cantidad válida en todas las filas.</p>
                `;
                panelResultado.className =
                    "bg-red-50/20 border-2 border-dashed border-red-300 rounded-sm p-8 flex flex-col items-center justify-center text-center min-h-[280px] transition-all duration-300";
                invalidarCotizacion();
                return;
            }

            let descuento = 0;
            if (subtotalGlobal >= DISCOUNT_THRESHOLD) {
                descuento = subtotalGlobal * 0.05;
            }

            const totalFinal = subtotalGlobal - descuento;

            // SOLO para pintar en el DOM (formato visual con comas)
            const totalVisual = totalFinal.toLocaleString("en-US", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            });
            const descuentoVisual = descuento.toFixed(2);
            const faltanteVisual = (DISCOUNT_THRESHOLD - subtotalGlobal).toFixed(2);

            // 1. Renderizar el HTML en el panel visual
            panelResultado.innerHTML = `
                <div class="flex flex-col items-center justify-center animate-fade-in w-full">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-blue-300 mb-2">Precio Total Estimado</span>
                    <h3 class="text-5xl font-black text-white font-['Arial_Narrow']">$${totalVisual} <span class="text-xl text-blue-300">USD</span></h3>

                    <div class="w-full flex justify-between text-xs text-slate-300 mt-4 px-4 border-t border-slate-700 pt-3">
                        <span>Total Unidades:</span>
                        <span class="font-bold">${cantidadUnidadesTotales}</span>
                    </div>

                    ${
                        descuento > 0
                            ? `
                        <div class="mt-3 bg-emerald-500/20 text-emerald-300 px-3 py-1.5 rounded-sm text-xs font-bold border border-emerald-500/40 flex items-center gap-1">
                            <span>🎉</span> Descuento del 5% Aplicado (-$${descuentoVisual})
                        </div>
                    `
                            : `
                        <p class="text-[10px] text-slate-400 mt-2">Te faltan $${faltanteVisual} USD para obtener el 5% de descuento.</p>
                    `
                    }
                </div>
            `;
            panelResultado.className =
                "bg-blue-600/10 border-2 border-dashed border-blue-500/50 rounded-sm p-8 flex flex-col items-center justify-center text-center min-h-[280px] transition-all duration-300";

            // 2. Armar mensaje de WhatsApp (unidades por tipo de producto)
            let mensajeWa = `Hola MASKEL PERÚ, soy ${nombreInput.value} de la empresa ${empresaInput.value} (RUC: ${rucInput.value} , Correo: ${correoInput.value} ).\n\n`;
            mensajeWa += `He cotizado en su página web el siguiente requerimiento:\n\n`;

            filas.forEach(function (fila) {
                const select = fila.querySelector<HTMLSelectElement>(".producto-select");
                const input = fila.querySelector<HTMLInputElement>(".cantidad-input");
                const cantidad = leerCantidad(input);
                const id = select ? select.value : "";

                if (id && MAPA_NOMBRES[id] && cantidad > 0) {
                    const nombreProducto = MAPA_NOMBRES[id];
                    const unidad =
                        id === "frp_grating" || id === "steel_grating"
                            ? "planchas"
                            : "unidades";
                    mensajeWa += `- ${cantidad} ${unidad} x ${nombreProducto}\n`;
                }
            });

            mensajeWa += `\n*TOTAL ESTIMADO: $${totalFinal.toFixed(2)} USD*\n\n`;
            mensajeWa += `Por favor, envíenme una cotización formal y confírmenme stock.`;

            if (btnWaSimulador) {
                btnWaSimulador.href = `https://wa.me/51984649227?text=${encodeURIComponent(mensajeWa)}`;
            }
            // Tras un cálculo válido, el carrito y el contacto están OK → habilitar
            setWaEnabled(true);

            // ============================================================
            // Payload con números puros (SIN formato ni comas)
            // ============================================================
            const datosCotizacion = {
                nombre: nombreInput.value,
                empresa: empresaInput.value,
                ruc: rucInput.value,
                correo: correoInput.value,
                qty_frp_grating: qtyFrpGrating,
                qty_steel_grating: qtySteelGrating,
                qty_m_clips: qtyMClips,
                qty_galv_clips: qtyGalvClips,
                subtotal: Number(subtotalGlobal.toFixed(2)),
                total: Number(totalFinal.toFixed(2)),
            };

            const urlGoogleSheets =
                "https://script.google.com/macros/s/AKfycbyUc3jXffHrq6e56R8Ljoa2OLQVUca1hOOZ2O39TvOZK3JDwynAxcq4NIVD5w4c5hjNZA/exec";

            fetch(urlGoogleSheets, {
                method: "POST",
                mode: "no-cors",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(datosCotizacion),
            })
                .then(function () {
                    console.log(
                        "Datos en columnas fijas guardados correctamente.",
                    );
                })
                .catch(function (err) {
                    console.error(
                        "Error al guardar en Google Sheets:",
                        err,
                    );
                });
            // ============================================================
        }

        // Disparo del cálculo: clic, submit nativo del form y tecla Enter
        if (btnCalcular) btnCalcular.addEventListener("click", ejecutarCalculo);
        if (formulario) {
            formulario.addEventListener("submit", function (e) {
                e.preventDefault();
                ejecutarCalculo();
            });
            // Accesibilidad de teclado: Enter en cualquier campo dispara el cálculo
            // (ignorado en <select> para no interferir con la elección por teclado)
            formulario.addEventListener("keydown", function (e) {
                if (e.target instanceof HTMLSelectElement) return;
                if (e.key === "Enter") {
                    e.preventDefault();
                    ejecutarCalculo();
                }
            });
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initSimulador, { once: true });
    } else {
        initSimulador();
    }
</script>
<style>
    .animate-fade-in {
        animation: fadeIn 0.3s ease-out;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
