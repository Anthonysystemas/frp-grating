---

<!-- Botón Flotante de Chat -->
<button
  type="button"
  class="chat-button group fixed bottom-5 right-5 z-[9999] animacion-latido flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-tr from-blue-700 via-blue-600 to-cyan-500 text-white shadow-xl shadow-blue-500/50 transition-all duration-200 hover:scale-105 hover:shadow-cyan-500/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 cursor-pointer relative"
  aria-label="Abrir cotizador"
  title="Cotizar ahora"
  data-chat-button
>
  <span class="pulse-radar" aria-hidden="true"></span>
  <svg
    class="relative z-10 h-7 w-7 fill-current shrink-0"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
    ></path>
  </svg>
  <span
    class="absolute -right-0.5 -top-0.5 z-20 h-3 w-3 rounded-full border-2 border-[#0A0E1A] bg-red-500 shadow"
    aria-hidden="true"
  ></span>
  <span
    class="chat-tooltip pointer-events-none absolute right-full z-20 mr-3 whitespace-nowrap rounded-md bg-[#0A0E1A] px-2.5 py-1.5 text-xs font-medium text-white shadow-lg"
  >Cotizar</span>
</button>

<script>
  document.querySelectorAll("[data-chat-button]").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.dispatchEvent(new CustomEvent("maskel:open-cotizador"));
    });
  });
</script>

<style>
  .chat-button {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
  }

  .chat-tooltip {
    display: none;
  }

  .pulse-radar {
    position: absolute;
    inset: 0;
    z-index: 0;
    border: 2px solid rgb(37 99 235 / 0.65);
    border-radius: 9999px;
    pointer-events: none;
    animation: pulseRadar 2.4s ease-out infinite;
  }

  @keyframes pulseRadar {
    0% {
      transform: scale(1);
      opacity: 0.75;
    }
    70%, 100% {
      transform: scale(1.85);
      opacity: 0;
    }
  }

  @media (hover: hover) and (min-width: 768px) {
    .chat-button:hover .chat-tooltip {
      display: block;
    }
  }

  .animacion-latido {
    animation: latidoCorazon 2.5s infinite;
  }
  @keyframes latidoCorazon {
    0% { transform: scale(1); }
    10% { transform: scale(1.08); }
    20% { transform: scale(1); }
    30% { transform: scale(1.08); }
    40% { transform: scale(1); }
    100% { transform: scale(1); }
  }
</style>
