---
// Panel global de cotización (paleta del sitio: fondo #0A0E1A, paneles #0D1220, acento blue-600).
// Se abre con el evento "maskel:open-cotizador" y se cierra con la X o el overlay.
import { CATALOG } from '../data/catalog';
import LogoM from "./icons/LogoM.astro";
import CotizadorPasoDatos from "./CotizadorPasoDatos.astro";
import CotizadorPasoResumen from "./CotizadorPasoResumen.astro";
---

<div
  id="cotizador-panel"
  class="fixed inset-0 z-[10000] bg-transparent"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="cotizador-title"
>
  <!-- Fondo oscurecido (sin blur) -->
  <div
    data-cotizador-overlay
    class="fixed inset-0 z-0 h-screen w-screen bg-black/60 opacity-0 transition-opacity duration-300"
  >
  </div>

  <!-- Panel: bottom-sheet en mobile, drawer lateral en desktop -->
  <div
    data-cotizador-sheet
    class="absolute inset-x-0 bottom-0 z-10 flex max-h-[90vh] translate-y-full flex-col overflow-hidden rounded-t-2xl border border-slate-800 bg-[#0A0E1A] text-slate-100 shadow-2xl transition-transform duration-300 ease-out sm:top-[5vh] sm:right-0 sm:bottom-[5vh] sm:left-auto sm:w-[440px] sm:translate-y-0 sm:translate-x-full sm:rounded-l-2xl sm:rounded-tr-none"
  >
    <!-- Header -->
    <div class="shrink-0 bg-blue-600 px-5 py-4 sm:px-6">
      <div class="mx-auto mb-3 h-1.5 w-12 rounded-full bg-white/40 sm:hidden"></div>

      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <LogoM class="h-11 w-11 shrink-0 text-white" />
          <div class="flex flex-col justify-center">
            <h2 id="cotizador-title" class="text-lg font-bold leading-tight text-white">
              Cotiza con Maskel
            </h2>
            <p class="mt-0.5 text-xs text-blue-100">Respuesta en minutos</p>
          </div>
        </div>

        <button
          type="button"
          data-cotizador-close
          class="-m-1 shrink-0 p-1 text-white transition-opacity hover:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          aria-label="Cerrar cotizador"
        >
          <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Cuerpo -->
    <div data-step-body class="min-h-0 flex-1 overflow-y-auto px-5 pb-5 pt-10 sm:px-6">
      <!-- 1. ELIGE TU PRODUCTO -->
      <div data-step-panel="1">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-400">
        1. Elige tu producto
      </p>

      <div class="mt-3 grid grid-cols-2 gap-3">
        <button
          type="button"
          data-category-card
          data-category="frp"
          aria-pressed="true"
          class="flex flex-col items-center gap-3 rounded-xl border-2 border-slate-800 bg-[#0D1220] px-3 py-4 text-center transition-colors hover:border-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 aria-pressed:border-blue-500"
        >
          <span
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#060913] text-lg text-slate-300"
            aria-hidden="true">▦</span
          >
          <span class="text-sm font-bold leading-tight text-white">FRP Grating</span>
        </button>

        <button
          type="button"
          data-category-card
          data-category="ducha"
          aria-pressed="false"
          class="flex flex-col items-center gap-3 rounded-xl border-2 border-slate-800 bg-[#0D1220] px-3 py-4 text-center transition-colors hover:border-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 aria-pressed:border-blue-500"
        >
          <span
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#060913] text-lg text-slate-300"
            aria-hidden="true">▨</span
          >
          <span class="text-sm font-bold leading-tight text-white">Rejillas de Ducha</span>
        </button>

        <button
          type="button"
          data-category-card
          data-category="clips"
          aria-pressed="false"
          class="col-span-2 flex flex-col items-center gap-3 rounded-xl border-2 border-slate-800 bg-[#0D1220] px-3 py-4 text-center transition-colors hover:border-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 aria-pressed:border-blue-500"
        >
          <span
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#060913] text-lg text-slate-300"
            aria-hidden="true">⚙</span
          >
          <span class="text-sm font-bold leading-tight text-white">Clips de Fijación M</span>
        </button>
      </div>

      <!-- MEDIDA -->
      <p class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-blue-400">Medida</p>
      <select
        data-measure
        class="mt-3 w-full rounded-lg border border-slate-700 bg-[#060913] px-4 py-3 text-sm text-white focus:border-blue-500 focus:outline-none"
      >
      </select>

      <!-- CANTIDAD -->
      <p data-unit-label class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-blue-400">
        Cantidad (panels)
      </p>
      <input
        type="number"
        data-quantity
        min="1"
        value="1"
        class="mt-3 w-full rounded-lg border border-slate-700 bg-[#060913] px-4 py-3 text-sm text-white focus:border-blue-500 focus:outline-none"
      />

      <!-- Subtotal -->
      <div
        class="mt-6 flex items-center justify-between border-t border-slate-700/70 px-1 pt-3"
      >
        <span class="text-sm text-slate-300">Subtotal</span>
        <strong data-subtotal class="text-2xl font-black text-white">US$ 310</strong>
      </div>

      <!-- Agregar a la cotización -->
      <button
        type="button"
        data-add
        class="mt-4 w-full rounded bg-blue-600 px-6 py-3.5 text-sm font-bold text-white transition-all duration-200 hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
      >
        + Agregar a la cotización
      </button>

      <!-- TU COTIZACIÓN -->
      <p class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-blue-400">
        Tu cotización
      </p>
      <div data-list class="mt-3">
        <p data-list-empty class="text-center text-sm text-slate-400">
          Aún no agregaste productos.
        </p>
        <ul data-list-items class="hidden flex-col"></ul>

        <div data-list-total class="mt-3 hidden items-center justify-between border-t border-slate-700/70 pt-3">
          <span class="text-sm text-slate-300">Total estimado</span>
          <strong data-total class="text-xl font-black text-white">US$ 0</strong>
        </div>
      </div>

      <button
        type="button"
        data-continue
        disabled
        class="mt-4 w-full rounded bg-blue-600/40 px-6 py-3.5 text-sm font-bold text-white transition-all duration-200 hover:bg-blue-600/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 disabled:cursor-not-allowed enabled:bg-blue-600 enabled:hover:bg-blue-500"
      >
        Continuar <span aria-hidden="true">→</span>
      </button>
    </div>
      <CotizadorPasoDatos embedded />
      <CotizadorPasoResumen embedded />
    </div>
  </div>
</div>

<script>
  const CATALOG = {
    frp: {
      label: "Rejilla FRP Grating",
      unit: "panel",
      selectorType: "dimension",
      options: [
        { code: "1000x4038-H38", label: "1000×4038mm · H38mm", price: 310 },
        { code: "1220x2440-H38", label: "1220×2440mm · H38mm", price: 230 },
        { code: "1000x4038-H25", label: "1000×4038mm · H25mm", price: 230 },
        { code: "1000x3000-H38", label: "1000×3000mm · H38mm", price: 230 },
        { code: "1000x3000-H25", label: "1000×3000mm · H25mm", price: 180 },
        { code: "1000x2000-H38", label: "1000×2000mm · H38mm", price: 150 },
      ],
    },
    ducha: {
      label: "Rejillas de ducha",
      unit: "unidad",
      selectorType: "model",
      options: [
        { code: "PT04", label: "Modelo PT04", price: 21.0 },
        { code: "PT10", label: "Modelo PT10", price: 19.5 },
        { code: "PT21", label: "Modelo PT21", price: 18.0 },
        { code: "PT02", label: "Modelo PT02", price: 19.5 },
        { code: "PT09", label: "Modelo PT09", price: 21.0 },
        { code: "PT20", label: "Modelo PT20", price: 21.0 },
      ],
    },
    clips: {
      label: "Clips de fijación M",
      unit: "unidad",
      selectorType: "compat",
      options: [
        { code: "clip-38mm", label: "Para rejilla FRP de 38mm", price: 0.79 },
        { code: "clip-25mm", label: "Para rejilla FRP de 25mm", price: 0.78 },
      ],
    },
  } as const;

  type CategoryKey = keyof typeof CATALOG;
  type QuoteLine = {
    id: number;
    productId: string;
    name: string;
    detail: string;
    qty: number;
    subtotal: number;
  };
  const root = document.getElementById("cotizador-panel");
  const overlay = root?.querySelector<HTMLElement>("[data-cotizador-overlay]");
  const sheet = root?.querySelector<HTMLElement>("[data-cotizador-sheet]");
  const closeBtn = root?.querySelector<HTMLElement>("[data-cotizador-close]");
  const cards = Array.from(
    root?.querySelectorAll<HTMLButtonElement>("[data-category-card]") ?? [],
  );
  const measure = root?.querySelector<HTMLSelectElement>("[data-measure]");
  const quantity = root?.querySelector<HTMLInputElement>("[data-quantity]");
  const unitLabel = root?.querySelector<HTMLElement>("[data-unit-label]");
  const subtotalEl = root?.querySelector<HTMLElement>("[data-subtotal]");
  const addBtn = root?.querySelector<HTMLButtonElement>("[data-add]");
  const listEmpty = root?.querySelector<HTMLElement>("[data-list-empty]");
  const listItems = root?.querySelector<HTMLUListElement>("[data-list-items]");
  const listTotal = root?.querySelector<HTMLElement>("[data-list-total]");
  const totalEl = root?.querySelector<HTMLElement>("[data-total]");
  const continueBtn = root?.querySelector<HTMLButtonElement>("[data-continue]");
  const closeQuoteBtn = root?.querySelector<HTMLButtonElement>("[data-close-quote]");
  const stepPanels = Array.from(
    root?.querySelectorAll<HTMLElement>("[data-step-panel]") ?? [],
  );

  const CLOSED = ["translate-y-full", "sm:translate-x-full"];
  const OPEN = ["translate-y-0", "sm:translate-x-0"];

  let isOpen = false;
  let category: CategoryKey = "frp";
  let quote: QuoteLine[] = [];
  let nextLineId = 1;

  function showStep(step: number) {
    stepPanels.forEach((panel) => {
      panel.hidden = panel.dataset.stepPanel !== String(step);
    });
  }

  const money = (value: number) =>
    `US$ ${value.toLocaleString("en-US", {
      minimumFractionDigits: Number.isInteger(value) ? 0 : 2,
      maximumFractionDigits: 2,
    })}`;

  const plural = (unit: string, amount: number) =>
    unit === "panel" ? (amount === 1 ? "panel" : "panels") : amount === 1 ? unit : `${unit}es`;

  function currentOption() {
    const options = CATALOG[category].options;
    const found = options.find((option) => option.code === measure?.value);
    return found ?? options[0];
  }

  function currentQty() {
    return Math.max(1, Math.floor(Number(quantity?.value) || 1));
  }

  function updateSubtotal() {
    const option = currentOption();
    if (subtotalEl) subtotalEl.textContent = money(option.price * currentQty());
  }

  function renderMeasureOptions() {
    const data = CATALOG[category];
    if (!measure) return;
    measure.innerHTML = data.options
      .map(
        (option) =>
          `<option value="${option.code}">${option.label} — ${money(option.price)} / ${data.unit}</option>`,
      )
      .join("");
    if (unitLabel) {
      unitLabel.textContent = `Cantidad (${plural(data.unit, 2)})`;
    }
    updateSubtotal();
  }

  function renderQuote() {
    if (!listItems || !listEmpty) return;
    const hasItems = quote.length > 0;

    listEmpty.classList.toggle("hidden", hasItems);
    listItems.classList.toggle("hidden", !hasItems);
    listItems.classList.toggle("flex", hasItems);
    listTotal?.classList.toggle("hidden", !hasItems);
    listTotal?.classList.toggle("flex", hasItems);
    if (continueBtn) continueBtn.disabled = !hasItems;

    listItems.innerHTML = quote
      .map(
        (line) => `
        <li class="flex items-start gap-3 border-b border-slate-800/70 py-3 first:border-t first:border-slate-800/70">
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-3">
              <span class="min-w-0 truncate text-sm font-bold text-white">${line.name}</span>
              <strong class="shrink-0 text-sm font-bold text-white">${money(line.subtotal)}</strong>
            </div>
            <p class="mt-1 text-xs leading-relaxed text-slate-400">${line.detail}</p>
          </div>
          <button
            type="button"
            data-remove="${line.id}"
            class="-mt-1 -mr-1 shrink-0 rounded p-1 text-slate-400 transition-colors hover:bg-slate-800 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
            aria-label="Eliminar ${line.name} de la cotización"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </li>`,
      )
      .join("");

    const total = quote.reduce((sum, line) => sum + line.subtotal, 0);
    if (totalEl) totalEl.textContent = money(total);
    sessionStorage.setItem("maskel:cotizacion", JSON.stringify(quote));
    document.dispatchEvent(new CustomEvent("maskel:cotizador-total", { detail: { total } }));
  }

  function removeLine(id: number) {
    quote = quote.filter((line) => line.id !== id);
    renderQuote();
  }

  function selectCategory(next: CategoryKey) {
    category = next;
    cards.forEach((card) =>
      card.setAttribute("aria-pressed", String(card.dataset.category === next)),
    );
    renderMeasureOptions();
  }

  function resetPanel() {
    quote = [];
    nextLineId = 1;
    if (quantity) quantity.value = "1";
    selectCategory("frp");
    renderQuote();
    showStep(1);
  }

  function openPanel() {
    if (!root || !overlay || !sheet || isOpen) return;
    isOpen = true;
    root.hidden = false;
    document.body.classList.add("overflow-hidden");

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        overlay.classList.remove("opacity-0");
        sheet.classList.remove(...CLOSED);
        sheet.classList.add(...OPEN);
      });
    });
  }

  function closePanel() {
    if (!root || !overlay || !sheet || !isOpen) return;
    isOpen = false;
    overlay.classList.add("opacity-0");
    sheet.classList.remove(...OPEN);
    sheet.classList.add(...CLOSED);
    document.body.classList.remove("overflow-hidden");

    window.setTimeout(() => {
      if (isOpen) return;
      if (root) root.hidden = true;
      resetPanel();
    }, 320);
  }

  document.addEventListener("maskel:open-cotizador", openPanel);
  document.addEventListener("maskel:cotizador-step", (event) => {
    const step = (event as CustomEvent<{ step: number }>).detail?.step;
    if (typeof step === "number") showStep(step);
  });

  closeBtn?.addEventListener("click", closePanel);
  closeQuoteBtn?.addEventListener("click", closePanel);
  overlay?.addEventListener("click", closePanel);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen) closePanel();
  });

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const next = card.dataset.category as CategoryKey | undefined;
      if (next && next in CATALOG) selectCategory(next);
    });
  });

  measure?.addEventListener("change", updateSubtotal);
  quantity?.addEventListener("input", updateSubtotal);

  addBtn?.addEventListener("click", () => {
    const option = currentOption();
    const qty = currentQty();
    const data = CATALOG[category];
    quote.push({
      id: nextLineId++,
      productId: option.code,
      name: data.label,
      detail: `${option.label} · ${qty} ${data.unit}(s)`,
      qty,
      subtotal: option.price * qty,
    });
    renderQuote();
  });

  listItems?.addEventListener("click", (event) => {
    const target = (event.target as Element).closest<HTMLElement>("[data-remove]");
    if (!target) return;
    removeLine(Number(target.dataset.remove));
  });

  continueBtn?.addEventListener("click", () => {
    sessionStorage.setItem("maskel:cotizacion", JSON.stringify(quote));
    document.dispatchEvent(new CustomEvent("maskel:cotizador-step", { detail: { step: 2 } }));
  });

  selectCategory("frp");
  renderQuote();
  showStep(1);
</script>
