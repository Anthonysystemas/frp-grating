---
// src/components/BenefitsFRP.astro

interface BenefitItem {
  titulo: string;
  subtitulo: string;
  descripcion: string;
  iconSvg: string;
  badge: string;
}

const beneficios: BenefitItem[] = [
  {
    titulo: "Resistencia a la Corrosión",
    subtitulo: "Inmunidad Química y Salina",
    descripcion: "No se oxida ni se degrada ante ácidos, álcalis, agua de mar o humedad extrema. Es la solución definitiva para ambientes corrosivos sin necesidad de pintura.",
    badge: "Anticorrosivo",
    iconSvg: `<svg class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L5.605 15.12a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>`
  },
  {
    titulo: "Superficie Antideslizante",
    subtitulo: "Máxima Seguridad Laboral",
    descripcion: "Acabado de grano de sílice (Grit Top) integrado térmicamente en la resina. Garantiza excelente tracción incluso en presencias de grasa, aceite o agua.",
    badge: "Antideslizante",
    iconSvg: `<svg class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`
  },
  {
    titulo: "Aislamiento Eléctrico",
    subtitulo: "Propiedades Dieléctricas",
    descripcion: "No conduce electricidad ni genera chispas por impacto mecánico. Esencial para la protección de personal en subestaciones, tableros y áreas de riesgo eléctrico.",
    badge: "Dieléctrico",
    iconSvg: `<svg class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
  {
    titulo: "Ligero y Fácil Instalación",
    subtitulo: "Ahorro en Operación",
    descripcion: "Pesa hasta un 70% menos que la rejilla de acero. Permite manipulaciones manuales sin grúas pesadas y cortes directos en campo con disco de diamante.",
    badge: "Bajo Peso",
    iconSvg: `<svg class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`
  }
];
---

<section id="beneficios" class="relative w-full bg-[#0E1728] py-24 px-6 overflow-hidden border-b border-slate-900/50">
  <!-- Fondo con Grid -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(#3B82F6 1px, transparent 1px), linear-gradient(90deg, #3B82F6 1px, transparent 1px); background-size: 48px 48px;"
  ></div>

  <div class="relative max-w-7xl mx-auto px-4">
    <!-- ENCABEZADO CENTRADO -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="h-px w-8 bg-blue-500"></span>
        <span class="text-blue-500 text-xs font-bold tracking-widest uppercase">
          Propiedades Destacadas
        </span>
        <span class="h-px w-8 bg-blue-500"></span>
      </div>

      <h2 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
        BENEFICIOS PRINCIPALES DEL <br />
        <span class="text-blue-500">MATERIAL FRP</span>
      </h2>

      <p class="mt-4 text-slate-400 text-lg leading-relaxed">
        Diseñadas para superar al acero convencional en los ambientes industriales más exigentes.
      </p>
    </div>

    <!-- GRID DE TARJETAS ALINEADAS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
      {beneficios.map((item) => (
        <div class="group relative bg-[#0D1220] border border-slate-800/60 rounded-2xl p-6 flex flex-col justify-between hover:border-blue-500/50 hover:shadow-xl hover:shadow-blue-500/5 transition-all duration-300">
          <div>
            <!-- 1. Header fijo: Icono + Badge -->
            <div class="flex items-center justify-between mb-6 h-10">
              <div class="p-2.5 bg-blue-600/10 border border-blue-500/20 rounded-xl group-hover:scale-105 group-hover:bg-blue-600/20 transition-all duration-300" set:html={item.iconSvg} />
              
              <span class="text-[10px] font-bold uppercase tracking-wider text-blue-400 bg-blue-500/10 px-2.5 py-1 rounded-full border border-blue-500/20">
                {item.badge}
              </span>
            </div>

            <!-- 2. Título con ALTO FIJO (Fuerza 2 líneas exactas para que todos calcen igual) -->
            <div class="h-14 flex items-center mb-1">
              <h3 class="text-xl font-bold text-white leading-snug group-hover:text-blue-400 transition-colors">
                {item.titulo}
              </h3>
            </div>

            <!-- 3. Subtítulo alineado -->
            <div class="h-6 flex items-center mb-4">
              <span class="text-xs font-mono text-slate-400 block">
                {item.subtitulo}
              </span>
            </div>

            <!-- 4. Descripción alineada -->
            <p class="text-slate-400 text-sm leading-relaxed">
              {item.descripcion}
            </p>
          </div>

          <!-- 5. Línea decorativa inferior en hover -->
          <div class="w-0 h-0.5 bg-blue-500 group-hover:w-full transition-all duration-500 mt-6"></div>
        </div>
      ))}
    </div>
  </div>
</section>