---
// src/components/Services.astro

interface ServiceItem {
  icon: 'truck' | 'ruler' | 'shield' | 'headset';
  title: string;
  badge?: string;
  description: string;
  benefits: string[];
}

const services: ServiceItem[] = [
  {
    icon: 'truck',
    title: 'Precios Competitivos de Importación',
    badge: 'Directo de Fábrica',
    description: 'Ofrecemos las mejores tarifas del mercado industrial sin intermediarios. Optimiza el presupuesto de tu proyecto sin sacrificar calidad.',
    benefits: ['Precios especiales por volumen', 'Cotización transparente sin costos ocultos']
  },
  {
    icon: 'headset',
    title: 'Atención y Respuesta Inmediata',
    badge: 'Soporte Express',
    description: 'Sabemos que las paradas de planta y licitaciones no pueden esperar. Te respondemos y cotizamos en minutos con atención personalizada.',
    benefits: ['Atención 24/7 para emergencias', 'Asesoría técnica inmediata por WhatsApp']
  },
  {
    icon: 'ruler',
    title: 'Fabricación y Modulación a Medida',
    badge: 'Proyectos Grating FRP',
    description: 'Dimensionamos y cortamos los paneles de Grating FRP a la geometría exacta de tus planos. Entregamos las piezas listas para instalar.',
    benefits: ['Cero desperdicio / merma en obra', 'Modulación según planos de ingeniería']
  },
  {
    icon: 'shield',
    title: 'Trabajos Rápidos y Stock Local',
    badge: 'Despacho Prioritario',
    description: 'Ejecutamos dimensionamientos urgentes y mantenemos stock disponible en Lima para despachos prioritarios a nivel nacional.',
    benefits: ['Envíos urgentes a provincia y minas', 'Garantía y fichas técnicas certificadas']
  }
];
---

<section id="servicios-makser" class="relative bg-[#070A13] py-20 px-6 border-b border-slate-900/50">
  <div class="relative max-w-6xl mx-auto">
    
    <!-- Encabezado de Sección -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="h-px w-8 bg-blue-500"></span>
          <span class="text-blue-500 text-sm font-bold tracking-widest uppercase">
            Ventaja Operativa
          </span>
        </div>
        <h2 class="text-3xl md:text-5xl font-black text-white leading-tight uppercase">
          Nuestras Ventajas Competitivas
        </h2>
      </div>
      <p class="text-slate-400 text-sm md:text-base max-w-md leading-relaxed">
        No solo suministramos FRP: resolvemos la logística y el dimensionamiento técnico para que tu proyecto se ejecute sin demoras.
      </p>
    </div>

    <!-- Grilla de Servicios / Valores de la Empresa -->
    <div class="grid md:grid-cols-2 gap-6">
      {services.map((item) => (
        <div class="bg-[#0D1220] border border-white/5 rounded-2xl p-8 hover:border-blue-500/40 transition-all duration-300 shadow-xl relative overflow-hidden flex flex-col justify-between group">
          
          <div>
            <div class="flex items-center justify-between mb-6">
              <!-- Ícono -->
              <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 group-hover:bg-blue-500 group-hover:text-white transition-all duration-300">
                {item.icon === 'truck' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 17a2 2 0 100-4 2 2 0 000 4zM18 17a2 2 0 100-4 2 2 0 000 4z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 011 1v2a1 1 0 01-1 1h-1m-6 0h6" />
                  </svg>
                )}
                {item.icon === 'ruler' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                )}
                {item.icon === 'shield' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {item.icon === 'headset' && (
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                )}
              </div>

              {item.badge && (
                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20">
                  {item.badge}
                </span>
              )}
            </div>

            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">
              {item.title}
            </h3>

            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              {item.description}
            </p>
          </div>

          <!-- Bullets de detalles -->
          <ul class="space-y-2 border-t border-white/5 pt-4 text-xs text-slate-300">
            {item.benefits.map((b) => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                <span>{b}</span>
              </li>
            ))}
          </ul>

        </div>
      ))}
    </div>

  </div>
</section>