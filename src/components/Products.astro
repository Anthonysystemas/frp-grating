---
// src/components/Products.astro

interface ProductData {
  type: string;
  dimensions: string;
  unit: string;
  subtitle: string;
  description: string;
  pdfLink: string;
  pdfText: string;
}

interface Props {
  badgeText?: string;
  titleLine1?: string;
  titleHighlight?: string;
  description?: string;
  product1?: ProductData;
  product2?: ProductData;
  product3?: ProductData;
}

const {
  badgeText = "Catálogo comercial · Stock Lima",
  titleLine1 = "LÍNEA DE",
  titleHighlight = "PRODUCTOS",
  description = "Tres configuraciones de rejilla FRP Grating disponibles en stock, listas para despacho en Lima. Cada ficha técnica incluye tolerancias, cargas admisibles y especificaciones de resina.",
  product1 = {
    type: "Tipo 01",
    dimensions: "38 × 38 × 25",
    unit: "mm",
    subtitle: "Cargas ligeras y tránsito peatonal",
    description: "Pasarelas, plataformas de planta, áreas de circulación interna y zonas de bajo tráfico.",
    pdfLink: "/fichas/rejilla-38x38x25.pdf",
    pdfText: "Ficha técnica PDF"
  },
  product2 = {
    type: "Tipo 02",
    dimensions: "38 × 38 × 38",
    unit: "mm",
    subtitle: "Carga pesada e industrial",
    description: "Plantas de proceso, minería, zonas con tránsito de equipos y cargas estructurales altas.",
    pdfLink: "/fichas/rejilla-38x38x38.pdf",
    pdfText: "Ficha técnica PDF"
  },
  product3 = {
    type: "Tipo 03",
    dimensions: "19 × 19 × 38",
    unit: "mm",
    subtitle: "Malla fina · seguridad",
    description: "MiniMesh para perímetros de seguridad, protección anticaída y zonas que requieren apertura reducida.",
    pdfLink: "/fichas/rejilla-19x19x38.pdf",
    pdfText: "Ficha técnica PDF"
  }
} = Astro.props;
