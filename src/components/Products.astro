<section id="productos" class="relative bg-[#0E1728] py-24 px-6 overflow-hidden border-b border-slate-900/50">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(#3B82F6 1px, transparent 1px), linear-gradient(90deg, #3B82F6 1px, transparent 1px); background-size: 48px 48px;"
  ></div>

  <div class="relative max-w-6xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
      <span class="h-px w-8 bg-blue-500"></span>
      <span class="text-blue-500 text-sm font-bold tracking-widest uppercase">
        {badgeText}
      </span>
    </div>

    <h2 class="text-4xl md:text-6xl font-black text-white leading-[1.05] mb-6">
      {titleLine1} <br class="md:hidden" />
      <span class="text-blue-500">{titleHighlight}</span>
    </h2>

    <p class="text-slate-400 text-lg max-w-2xl mb-14 leading-relaxed">
