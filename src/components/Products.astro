---
// 1. Tipado de TypeScript
export interface ProductItem {
  title: string;
  description: string;
  image: string;
  link: string;
  badge?: string;
  specifications?: string[];
  buttonText?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  products?: ProductItem[];
}

// 2. Extraer Props con valores por defecto
const {
  title = "Nuestros Productos",
  subtitle = "Soluciones avanzadas en plástico reforzado con fibra de vidrio (FRP) para la industria.",
  products = []
} = Astro.props;
---

<section id="productos" class="w-full py-20 bg-[#0B1120] text-white relative">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Encabezado de la Sección -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-5xl font-black tracking-tight mb-4 uppercase font-['Arial_Narrow',sans-serif]">
        {title}
      </h2>
      <p class="text-slate-400 text-base md:text-lg">
        {subtitle}
      </p>
      <div class="w-20 h-1 bg-blue-600 mx-auto mt-6"></div>
    </div>

    <!-- Rejilla de Productos (Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {products.map((product) => (
        <article class="bg-[#131C2E] border border-slate-800 rounded-lg overflow-hidden flex flex-col justify-between hover:border-blue-500/50 transition-all duration-300 shadow-xl group">
          
          <!-- Imagen y Badge -->
          <div>
            <div class="relative h-52 overflow-hidden bg-slate-900">
              {product.badge && (
                <span class="absolute top-3 right-3 z-10 bg-blue-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
                  {product.badge}
                </span>
              )}
              <img
                src={product.image}
                alt={product.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
                loading="lazy"
              />
            </div>

            <!-- Contenido de la tarjeta -->
            <div class="p-6">
              <h3 class="text-xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">
                {product.title}
              </h3>
              <p class="text-slate-400 text-sm mb-6 line-clamp-3 leading-relaxed">
                {product.description}
              </p>

              <!-- Especificaciones técnicas (si existen) -->
              {product.specifications && product.specifications.length > 0 && (
                <div class="border-t border-slate-800/80 pt-4 mb-2">
                  <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                    Especificaciones clave:
                  </h4>
                  <ul class="space-y-1.5">
                    {product.specifications.map((spec) => (
                      <li class="text-xs text-slate-300 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 shrink-0"></span>
                        <span>{spec}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>

          <!-- Botón de Acción -->
          <div class="p-6 pt-0 mt-auto">
            <a
              href={product.link}
              class="w-full inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-blue-600 text-white font-medium py-3 px-4 rounded transition-all duration-200 text-sm tracking-wide border border-slate-700 hover:border-blue-500"
            >
              <span>{product.buttonText || "Ver detalles tecnicos"}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>

        </article>
      ))}
    </div>

  </div></section>