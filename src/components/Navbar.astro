---
// Navbar.astro
---

<header class="fixed top-0 left-0 w-full z-50 bg-[#0A0E1A]/90 backdrop-blur-md border-b border-slate-800">
  <!-- Barra de Navegación Principal -->
  <nav class="max-w-6xl mx-auto w-full px-6 py-4">
    <div class="flex justify-between items-center gap-4">
      <!-- Logo -->
      <a
        href="/#home"
        class="flex items-center cursor-pointer shrink-0"
        aria-label="Ir al inicio"
      >
        <img
          src="/logo.png"
          alt="Logo MASKEL PERÚ"
          class="h-10 w-auto object-contain"
        />
      </a>

      <!-- Menú desktop centrado, alineado y animado -->
      <div class="hidden md:flex gap-6 flex-1 justify-center items-center">
        <a
          href="/#home"
          class="text-sm font-bold tracking-wider text-slate-300 hover:text-white transition-all duration-300 transform hover:scale-105 relative group py-1"
        >
          Inicio
          <span
            class="absolute bottom-0 left-1/2 w-0 h-0.5 bg-blue-500 transition-all duration-300 group-hover:w-full group-hover:left-0"
          ></span>
        </a>

        <!-- Opción Productos con Dropdown Desplegable -->
        <div class="relative group inline-block py-1">
          <a
            href="/#productos"
            class="text-sm font-bold tracking-wider text-slate-300 hover:text-white transition-all duration-300 transform hover:scale-105 relative inline-flex items-center gap-1.5"
          >
            <span>Productos</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-white transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
            <span
              class="absolute bottom-0 left-1/2 w-0 h-0.5 bg-blue-500 transition-all duration-300 group-hover:w-full group-hover:left-0"
            ></span>
          </a>

          <!-- Submenú Flotante -->
          <div class="absolute left-0 top-full pt-2 w-60 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="bg-[#0D1220] border border-slate-800 rounded-xl shadow-2xl p-2 flex flex-col gap-1 backdrop-blur-md">
                 <a
                 href="/#frp" 
                 class="px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-blue-600/20 transition-colors flex items-center justify-between group/item"
               >
                 <span>Fibra de Vidrio (FRP)</span>
                 <span class="text-blue-400 opacity-0 group-hover/item:opacity-100 transition-opacity text-xs">→</span>
                </a>
              <a 
                href="/drenajes-y-canaletas" 
                class="px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-blue-600/20 transition-colors flex items-center justify-between group/item"
              >
                <span>Drenajes y Canaletas</span>
                <span class="text-blue-400 opacity-0 group-hover/item:opacity-100 transition-opacity text-xs">→</span>
              </a>
              <a 
                href="/#grating-metalico" 
                class="px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-blue-600/20 transition-colors flex items-center justify-between group/item"
              >
                <span>Grating Metálico</span>
                <span class="text-blue-400 opacity-0 group-hover/item:opacity-100 transition-opacity text-xs">→</span>
              </a>
              <a
                href="/peldaños"
                class="px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-blue-600/20 transition-colors flex items-center justify-between group/item"
              >
                <span>Peldaños </span>
                <span class="text-blue-400 opacity-0 group-hover/item:opacity-100 transition-opacity text-xs">→</span>
                </a>
              
               
            </div>
          </div>
        </div>

        <a 
          href="/#nosotros"
          class="text-sm font-bold tracking-wider text-slate-300 hover:text-white transition-all duration-300 transform hover:scale-105 relative group py-1"
        >
          Nosotros
          <span
            class="absolute bottom-0 left-1/2 w-0 h-0.5 bg-blue-500 transition-all duration-300 group-hover:w-full group-hover:left-0"
          ></span>
        </a>

        <a
          href="/#galeria"
          class="text-sm font-bold tracking-wider text-slate-300 hover:text-white transition-all duration-300 transform hover:scale-105 relative group py-1"
        >
          Galería
          <span
            class="absolute bottom-0 left-1/2 w-0 h-0.5 bg-blue-500 transition-all duration-300 group-hover:w-full group-hover:left-0"
          ></span>
        </a>

        <a
          href="/#location"
          class="text-sm font-bold tracking-wider text-slate-300 hover:text-white transition-all duration-300 transform hover:scale-105 relative group py-1"
        >
          Ubicación
          <span
            class="absolute bottom-0 left-1/2 w-0 h-0.5 bg-blue-500 transition-all duration-300 group-hover:w-full group-hover:left-0"
          ></span>
        </a>
      </div>

      <!-- Botón Cotizar y Hamburguesa Móvil -->
      <div class="flex items-center gap-2">
        <a
          href="/#simulator"
          class="bg-blue-600 hover:bg-blue-500 text-white text-sm font-bold px-4 py-2.5 rounded cursor-pointer transition-all duration-200 inline-flex items-center gap-2 whitespace-nowrap"
        >
          Cotizar
        </a>

        <button
          id="menu-toggle"
          class="md:hidden p-2 text-slate-300 hover:text-white transition-colors"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Menú móvil (Desplegable) -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-[#0A0E1A] border-t border-slate-800/50 px-6 py-4 space-y-3"
  >
    <div
      class="pb-3 mb-3 border-b border-slate-800/60 space-y-2 text-sm text-slate-300"
    >
      <a
        href="tel:+51988168786"
        class="block hover:text-white transition-colors"
      >(+51) 988 168 786</a>
      <a
        href="tel:+51944898564"
        class="block hover:text-white transition-colors"
      >(+51) 944 898 564</a>
      <a
        href="mailto:ventas@maskelperu.com"
        class="block hover:text-white transition-colors"
      >ventas@maskelperu.com</a>
      <span class="block text-slate-500">SMP, Lima - Perú</span>
    </div>
    <a
      href="/#home"
      class="block text-sm font-bold text-slate-300 tracking-wider hover:text-white transition-colors duration-200"
    >Inicio</a>
    <a
      href="/drenajes-y-canaletas"
      class="block text-sm font-bold text-blue-400 tracking-wider hover:text-blue-300 transition-colors duration-200"
    >↳ Drenajes y Canaletas</a>
    <a
      href="/#productos"
      class="block text-sm font-bold text-slate-300 tracking-wider hover:text-white transition-colors duration-200"
    >Productos (Grating)</a>
    <a
      href="/#galeria"
      class="block text-sm font-bold text-slate-300 tracking-wider hover:text-white transition-colors duration-200"
    >Galería</a>
    <a
      href="/#simulator"
      class="block text-sm font-bold text-slate-300 tracking-wider hover:text-white transition-colors duration-200"
    >Simular Cotización</a>
    <a
      href="/#location"
      class="block text-sm font-bold text-slate-300 tracking-wider hover:text-white transition-colors duration-200"
    >Ubicación</a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  toggleBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>