---
interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;

---

<div data-step-panel="3" hidden={embedded}>
  <div class="flex flex-col items-center text-center">
    <div
      class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-blue-500 bg-blue-600/15 text-blue-400"
      aria-hidden="true"
    >
      <svg
        class="h-9 w-9"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m5 12 4 4L19 6"></path>
      </svg>
    </div>

    <h3 class="mt-4 text-2xl font-black leading-tight text-white">¡Cotización generada!</h3>
    <p class="mt-2 text-sm text-slate-300">Guarda tu código para hacerle seguimiento</p>
  </div>

  <div
    class="mt-6 rounded-xl border border-slate-700 bg-[#0D1220] px-4 py-5 text-center"
  >
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Código de cotización</p>
    <p data-quote-code class="mt-3 font-mono text-2xl font-bold tracking-wide text-white">—</p>
  </div>

  <div class="mt-6">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-400">Resumen de productos</p>

    <div class="mt-3">
      <div data-quote-lines></div>

      <div class="mt-3 flex items-center justify-between border-t border-slate-700/70 px-1 pt-3">
        <span class="text-sm text-slate-300">Total estimado</span>
        <strong data-quote-total class="text-xl font-black text-white">US$ 0.00</strong>
      </div>
    </div>
  </div>

  <div class="mt-6 space-y-3">
    <button
      type="button"
      data-download-pdf
      class="flex w-full items-center justify-center gap-2 rounded bg-blue-600 px-6 py-3.5 text-sm font-bold text-white transition-all duration-200 hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3v12"></path>
        <path d="m7 10 5 5 5-5"></path>
        <path d="M5 21h14"></path>
      </svg>
      Descargar PDF
    </button>

    <button
      type="button"
      data-send-whatsapp
      class="flex w-full items-center justify-center gap-2 rounded border border-blue-500 bg-transparent px-6 py-3.5 text-sm font-bold text-blue-400 transition-all duration-200 hover:bg-blue-500/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 11.5a8 8 0 0 1-11.8 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z"></path>
        <path d="M8.5 9.2c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.6 1.4c.1.2.1.4-.1.6l-.5.6c.5 1 1.3 1.8 2.3 2.3l.6-.5c.2-.2.4-.2.6-.1l1.4.6c.3.1.4.3.4.5v.5c0 .3 0 .5-.4.7-.3.2-.8.3-1.2.2-2.8-.6-5-2.8-5.6-5.6-.1-.4 0-.9.2-1.2Z"></path>
      </svg>
      Enviar por WhatsApp
    </button>
  </div>

  <button
    type="button"
    data-close-quote
    class="mx-auto mt-6 block text-xs text-slate-400 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
  >
    Cerrar y volver al sitio
  </button>
</div>

<script>
  type QuoteResult = {
    codigo: string;
    total: string;
    pdfBase64: string;
    items: Array<{ nombre: string; detalle: string; qty: number; subtotalCentavos: number }>;
  };

  const root = document.getElementById("cotizador-panel");
  const panel = root?.querySelector<HTMLElement>('[data-step-panel="3"]');
  let result: QuoteResult | null = null;

  const money = (centavos: number) => `US$ ${(centavos / 100).toFixed(2)}`;

  document.addEventListener("maskel:cotizacion-generada", (event) => {
    result = (event as CustomEvent<QuoteResult>).detail;
    const code = panel?.querySelector<HTMLElement>("[data-quote-code]");
    const total = panel?.querySelector<HTMLElement>("[data-quote-total]");
    const lines = panel?.querySelector<HTMLElement>("[data-quote-lines]");
    if (code) code.textContent = result.codigo;
    if (total) total.textContent = `US$ ${result.total}`;
    if (lines) {
      lines.innerHTML = result.items.map((item) => `
        <div class="flex items-start gap-3 border-b border-slate-800/70 py-3 first:border-t first:border-slate-800/70">
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-3">
              <span class="min-w-0 truncate text-sm font-bold text-white">${item.nombre}</span>
              <strong class="shrink-0 text-sm font-bold text-white">${money(item.subtotalCentavos)}</strong>
            </div>
            <p class="mt-1 text-xs leading-relaxed text-slate-400">${item.detalle} · ${item.qty} unidad(es)</p>
          </div>
        </div>`).join("");
    }
  });

  panel?.querySelector<HTMLButtonElement>("[data-download-pdf]")?.addEventListener("click", () => {
    if (!result) return;
    const bytes = Uint8Array.from(atob(result.pdfBase64), (character) => character.charCodeAt(0));
    const url = URL.createObjectURL(new Blob([bytes], { type: "application/pdf" }));
    const link = document.createElement("a");
    link.href = url;
    link.download = `${result.codigo}.pdf`;
    link.click();
    URL.revokeObjectURL(url);
  });

  panel?.querySelector<HTMLButtonElement>("[data-send-whatsapp]")?.addEventListener("click", () => {
    if (!result) return;
    const items = result.items
      .map((item) => `- ${item.nombre} (${item.detalle}) x${item.qty}`)
      .join("\n");
    const mensaje = [
      "Hola, acabo de generar una cotización con Maskel.",
      "",
      `Código: ${result.codigo}`,
      "",
      "Productos:",
      items,
      "",
      `Total: US$ ${result.total}`,
      "",
      "El detalle completo ya fue enviado a su equipo por correo.",
    ].join("\n");
    window.location.href = "https://wa.me/51984649227?text=" + encodeURIComponent(mensaje);
  });
</script>
