---
// src/components/FrpSeccion.astro
---

<section id="frp-destacado" class="relative w-full bg-[#080C16] py-16 px-4 sm:px-6 border-b border-slate-900/60 overflow-hidden">
  <!-- Glow decorativo de fondo -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,var(--tw-gradient-stops))] from-blue-900/20 via-transparent to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="bg-linear-to-r from-[#0D1322] to-[#111827] border border-blue-500/20 rounded-2xl p-6 sm:p-10 shadow-2xl">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- COLUMNA IZQUIERDA: INFORMACIÓN Y VENTAJAS -->
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold uppercase tracking-wider">
            🛡️ USO INDUSTRIAL / ALTA RESISTENCIA CORROSIVA
          </div>

          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight uppercase">
            Rejillas de <span class="text-blue-500">Fibra de Vidrio</span> (Grating FRP)
          </h2>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            En <strong class="text-white">Maskel Perú</strong> suministramos rejillas <strong class="text-white">Grating FRP</strong> diseñadas para resistir la corrosión química, marina e industrial. La solución ideal que reemplaza al acero convencional por su ligereza y nulo mantenimiento.
          </p>

          <!-- PROPIEDADES TÉCNICAS -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-xs text-slate-300">
            <div class="flex items-center gap-2 bg-[#0A0E1A] p-2.5 rounded-lg border border-slate-800">
              <span class="text-blue-400 font-bold">✓</span>
              <span>100% Anticorrosivo</span>
            </div>
            <div class="flex items-center gap-2 bg-[#0A0E1A] p-2.5 rounded-lg border border-slate-800">
              <span class="text-blue-400 font-bold">✓</span>
              <span>Dieléctrico / Aislante</span>
            </div>
            <div class="flex items-center gap-2 bg-[#0A0E1A] p-2.5 rounded-lg border border-slate-800">
              <span class="text-blue-400 font-bold">✓</span>
              <span>Superficie Antideslizante</span>
            </div>
            <div class="flex items-center gap-2 bg-[#0A0E1A] p-2.5 rounded-lg border border-slate-800">
              <span class="text-blue-400 font-bold">✓</span>
              <span>Retardante al Fuego</span>
            </div>
            <div class="flex items-center gap-2 bg-[#0A0E1A] p-2.5 rounded-lg border border-slate-800">
              <span class="text-blue-400 font-bold">✓</span>
              <span>Bajo Peso Estructural</span>
            </div>
            <div class="flex items-center gap-2 bg-[#0A0E1A] p-2.5 rounded-lg border border-slate-800">
              <span class="text-blue-400 font-bold">✓</span>
              <span>Dimensionado a Medida</span>
            </div>
          </div>

          <!-- BOTONES DE ACCIÓN -->
          <div class="pt-4 flex flex-wrap gap-4">
            <a 
              href="/grating-frp" 
              class="bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs uppercase px-6 py-3 rounded-lg transition-all shadow-lg shadow-blue-600/30 flex items-center gap-2"
            >
              Ficha Técnica de FRP →
            </a>
            <a 
              href="#simulator"
              
              rel="noopener noreferrer"
              class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase px-6 py-3 rounded-lg transition-all shadow-lg shadow-emerald-600/20 flex items-center gap-2"
            >
              Cotizar FRP por WhatsApp
            </a>
          </div>
        </div>

        <!-- COLUMNA DERECHA: FOTO DEL PRODUCTO -->
        <div class="lg:col-span-5 relative group">
          <div class="relative rounded-xl overflow-hidden border border-slate-800 shadow-2xl bg-[#0A0E1A]">
            <img 
              src="/images/rejillas4.jpg" 
              alt="Rejillas Grating FRP Fibra de Vidrio Maskel Perú" 
              class="w-full h-80 sm:h-95 object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
              loading="lazy"
            />
            
            <!-- Superposición de sombra e información sobre la foto -->
            <div class="absolute inset-0 bg-linear-to-t from-[#0A0E1A] via-transparent to-transparent opacity-80"></div>
            
            <div class="absolute bottom-4 left-4 right-4 bg-[#0A0E1A]/90 backdrop-blur border border-slate-800 p-3 rounded-lg">
              <p class="text-xs font-bold text-white uppercase">Resinas ISO / OFTA / VINIL</p>
              <p class="text-[11px] text-slate-400">Paneles moldeados y pultruidos de alta durabilidad para proyectos industriales.</p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>