---
const phone = "51984649227";
const message = encodeURIComponent("Hola Makser, deseo solicitar una cotización de Peldaños Metálicos a medida.");
---

<section id="peldanos" class="w-full bg-[#0A0E1A] py-20 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div class="space-y-6">
      <div class="flex items-center gap-2">
        <span class="w-8 h-0.5 bg-blue-500 inline-block"></span>
        <span class="text-xs uppercase tracking-widest text-blue-400 font-semibold">Máxima Seguridad Estructural</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">Peldaños <span class="text-blue-500">Metálicos</span></h2>
      <p class="text-slate-300 leading-relaxed">Fabricamos peldaños a la medida de tu proyecto, configurables con platinas <strong class="text-white">lisas</strong> o <strong class="text-white">dentadas</strong> en acero natural o galvanizado en caliente.</p>
      <div class="bg-[#0D1220] border-l-4 border-blue-500 border-y-slate-800/80 border-r-slate-800/80 p-5 rounded-r-xl">
        <h3 class="text-white font-bold text-sm uppercase tracking-wide mb-1">Resistencia en Ambientes Severos</h3>
        <p class="text-xs text-slate-400 leading-relaxed">Sistema de fijación mediante tornillos para facilitar el mantenimiento y reemplazo en ambientes húmedos o corrosivos.</p>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-300">
        <li class="bg-[#060913] p-3 rounded-lg border border-slate-800">✓ Escaleras de emergencia</li>
        <li class="bg-[#060913] p-3 rounded-lg border border-slate-800">✓ Alto tránsito peatonal</li>
        <li class="bg-[#060913] p-3 rounded-lg border border-slate-800">✓ Pisos antideslizantes</li>
        <li class="bg-[#060913] p-3 rounded-lg border border-slate-800">✓ Plataformas industriales</li>
      </ul>
      <a href={`https://wa.me/${phone}?text=${message}`} target="_blank" rel="noopener noreferrer" class="inline-flex bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 px-8 rounded-lg text-xs uppercase tracking-wider">Cotizar Peldaños por WhatsApp</a>
    </div>
    <div class="relative bg-[#0D1220] border border-slate-800 rounded-xl overflow-hidden shadow-2xl aspect-video sm:aspect-square flex flex-col justify-end p-6">
      <img src="/images/peldanos1.jpg" alt="Peldaños metálicos antideslizantes" class="absolute inset-0 w-full h-full object-cover opacity-60" loading="lazy" />
      <div class="absolute inset-0 bg-linear-to-t from-[#0D1220] via-[#0D1220]/40 to-transparent"></div>
      <div class="relative z-10"><span class="text-[10px] uppercase font-bold tracking-widest text-blue-400">Fabricación a Medida</span><h3 class="text-xl font-bold text-white">Superficie Antideslizante</h3></div>
    </div>
  </div>
</section>
