---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PeldanosSection from '../components/PeldanosSection.astro';
import QuoteFormMetalico from '../components/QuoteFormMetalico.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth bg-[#0A0E1A]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Básico -->
    <title>Peldaños Metálicos Antideslizantes | Makser Perú</title>
    <meta 
      name="description" 
      content="Fabricación de peldaños metálicos de cualquier tamaño, platinas lisas o dentadas en acero natural o galvanizado en caliente para escaleras de emergencia e industriales." 
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:title" content="Peldaños Metálicos Antideslizantes | Makser Perú" />
    <meta property="og:description" content="Peldaños a medida con sistema de fijación mediante tornillos y máxima seguridad para alto tránsito." />
    <meta property="og:type" content="website" />
  </head>

  <body class="text-slate-100 min-h-screen flex flex-col justify-between">
    
    <Navbar />

    <main class="flex-1">
      
      <!-- Sección Detallada del Producto -->
      <PeldanosSection />

      <!-- Formulario de Cotización Adapable -->
      <QuoteFormMetalico />

    </main>

    <!-- Botón flotante de WhatsApp personalizado para Peldaños -->
    <WhatsAppButton 
      message="Hola Makser, deseo una cotización de Peldaños Metálicos a medida." 
    />

    <Footer />

  </body>
</html>