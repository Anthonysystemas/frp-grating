---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminHeader from "../../components/admin/AdminHeader.astro";
import AdminToolbar from "../../components/admin/AdminToolbar.astro";
import AdminStates from "../../components/admin/AdminStates.astro";
import ApproveModal from "../../components/admin/ApproveModal.astro";
import Toast from "../../components/admin/Toast.astro";
---

<AdminLayout>
  <AdminHeader />

  <main class="relative mx-auto w-full max-w-7xl px-4 pb-20 pt-6 sm:px-6 sm:pt-8 lg:px-8">
    <AdminToolbar />
    <AdminStates />
    <section id="list" class="mt-5 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" aria-live="polite"></section>
  </main>

  <ApproveModal />
  <Toast />
</AdminLayout>

<script>
  import { initAdmin } from "../../lib/admin/client";

  initAdmin();
</script>
