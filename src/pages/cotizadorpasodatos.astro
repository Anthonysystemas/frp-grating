---
import "../styles/global.css";
import CotizadorPasoDatos from "../components/CotizadorPasoDatos.astro";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Tus datos | Maskel</title>
    <meta
      name="description"
      content="Completa tus datos para recibir tu cotización de Maskel."
    />
  </head>
  <body class="min-h-screen bg-[#0A0E1A] text-slate-100 antialiased">
    <main class="flex min-h-screen items-center justify-center bg-[#0A0E1A] px-4 py-8 sm:px-6">
      <section
        id="cotizador-panel"
        class="w-full max-w-[440px] overflow-hidden rounded-2xl border border-slate-800 bg-[#0A0E1A] shadow-2xl"
        aria-label="Datos de contacto para cotización"
      >
        <div class="border-b border-slate-800 bg-[#0D1220] px-5 py-5 sm:px-6">
          <h1 class="text-lg font-bold leading-tight text-white">Cotiza con Maskel</h1>
          <p class="mt-1 text-xs text-slate-400">Completa tus datos de contacto</p>
        </div>
        <div class="px-5 py-5 sm:px-6">
          <CotizadorPasoDatos />
        </div>
      </section>
    </main>
  </body>
</html>
