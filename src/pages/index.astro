---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Products from "../components/Products.astro";
import About from "../components/About.astro";
import FrpSeccion from "../components/FrpSeccion.astro";
import DuchaSeccion from "../components/DuchaSeccion.astro";
import ChatButton from '../components/ChatButton.astro';
import Layout from "../layouts/Layout.astro";
import { categorias } from "../data/catalog";

const maskelProducts = categorias.map((categoria) => ({
  title: categoria.titulo,
  description: categoria.descripcion,
  image: categoria.imagen,
  link: categoria.ruta,
  badge: categoria.badge,
  tag: categoria.etiqueta,
  specifications: [...categoria.especificaciones],
}));
---

<Layout
  title="Maskel Perú | Soluciones Industriales en Grating FRP y Rejillas de Ducha"
  description="Fabricación e Importación y distribución directa de Grating FRP y rejillas de ducha de alta resistencia anticorrosiva para minería e industria."
>
    <!-- Navbar Global -->
    <Navbar />

    <main class="grow">
      <!-- Sección Hero Principal -->
      <Hero
        title="GRATING FRP Y REJILLAS DE DUCHA PARA APLICACIONES INDUSTRIALES"
        subtitle="Importación y distribución directa de Grating FRP, rejillas de ducha y clips de fijación. Stock estandarizado para entrega inmediata."
        ctaText="Simular Cotización"
        secondaryCtaText="Ver Productos"
        secondaryCtaLink="#productos"
      />
      <About />

      <FrpSeccion />

      <DuchaSeccion />


      <!-- Sección de Productos / Catálogo -->
      <section id="catalogo">
        <Products
          title="NUESTRO CATÁLOGO DE PRODUCTOS"
          subtitle="Selecciona el producto que necesitas para ver sus especificaciones detalladas y consultar disponibilidad."
          products={maskelProducts}
        />
      </section>

    

    </main>

    <!-- Footer Global -->
    <Footer />

    <ChatButton />
</Layout>
