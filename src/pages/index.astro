---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Products from "../components/Products.astro";
import Simulator from "../components/Simulator.astro";
import SolutionsSection from "../components/SolutionsSection.astro";
import About from "../components/About.astro";
import "../styles/global.css";
import FrpSeccion from "../components/FrpSeccion.astro";

const makserProducts = [
  {
  title: "Rejilla Lineal de Ducha",
  description: "Rejillas delgadas y únicas para baño en Acero Inoxidable AISI 304. Diseño moderno de alta durabilidad, disponible en modelos desde MK1 hasta MK9.",
  image: "/images/rejilladucha.jpg",
  link: "/rejillas-de-ducha",
  badge: "Acero Inoxidable AISI 304",
  specifications: [
    "Material: Acero Inoxidable Calidad AISI 304",
    "Medidas: 7cm × 80cm × 2cm | 7cm × 90cm × 2cm | 7cm × 1m × 2cm (Profundidad)",
    "Modelos disponibles: Serie MK1, MK2, MK3, MK4, MK5, MK6, MK7, MK8 y MK9",
    "Propiedad: Alta resistencia a la corrosión y acabado de lujo"
  ],
},
  {
    title: "Rejillas de Drenaje y Canaletas",
    description: "Canaletas y rejillas metálicas o de FRP diseñadas para la evacuación fluida y tránsito pesado.",
    image: "/images/drenaje.jpg",
    link: "/rejillas-de-drenaje", // <--- Esta es la ruta exacta del archivo que creamos
    badge: "Fabricación / Importación",
    specifications: [
        "Material: Acero Galvanizado / FRP",
        "Alta resistencia a cargas de tránsito",
        "Diseño a medida según plano"
    ],
},
  {
    title: "Peldaños de Escalera",
    description:
      "Peldaños estructurales de alta seguridad con borde de contraste visual y superficie rugosa para prevención de caídas.",
    image: "/images/peldaños.jpg",
    link: "/peldanos-escalera",
    badge: "Seguridad Industrial",
    specifications: [
      "Borde: Nariz de seguridad integrada",
      "Superficie: Grit antideslizante",
      "Carga: Alta capacidad de impacto",
    ],
  },
  {
    title: "Fabricación de Grating Metálico",
    description:
      "Rejillas electrosoldadas en Acero ASTM A36 Tipo 19W-4 (lisas o dentadas) para tránsito peatonal y pesado. Fabricadas bajo norma NAAMM MBG 531/532.",
    image: "/images/rejillas3.jpg", // Asegúrate de que la foto sea de grating metálico
    link: "/grating-metalico",
    badge: "Norma NAAMM",
    specifications: [
      "Material: Acero ASTM A36 (Electrosoldado)",
      "Norma: NAAMM MBG 531 (Peatonal) / 532 (Pesado)",
      "Formato: Paneles de 1m x 6m, 1.2m x 6m y a medida",
    ],
  },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>
      Makser Perú | Soluciones Industriales en Grating, Drenaje y Peldaños FRP
    </title>
    <meta
      name="description"
      content="Fabricación e importación de Grating, Rejillas de Drenaje y Peldaños FRP de alta resistencia anticorrosiva para minería e industria."
    />
  </head>
  <body
    class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between"
  >
    <!-- Navbar Global -->
    <Navbar />
    

    <main class="grow">
      <!-- Sección Hero Principal -->
      <Hero
        title="Soluciones Industriales en Grating Metálico y FRP"
        subtitle="Importación directa de Grating FRP y fabricación a medida de Grating Metálico, Peldaños y Rejillas de Drenaje."
        ctaText="Cotizar por WhatsApp"
        ctaLink="https://wa.me/51984649227?text=Hola%20Makser,%20deseo%20una%20cotizacion%20de%20productos%20FRP"
        secondaryCtaText="Ver Catálogo FRP"
        secondaryCtaLink="#catalogo"
      />
      <About />
      
      <FrpSeccion/>

      <!-- Sección de Productos / Catálogo -->
      <section id="catalogo">
        <Products
          title="Nuestras Líneas de Productos FRP"
          subtitle="Selecciona la solución que necesitas para ver especificaciones detalladas y solicitar una cotización a medida."
          products={makserProducts}
        />
      </section>

      <Simulator />

    
    </main>

    <!-- Footer Global -->
    <Footer />
  </body>
</html>
