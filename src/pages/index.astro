---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Products from "../components/Products.astro";
import Simulator from "../components/Simulator.astro";
import About from "../components/About.astro";
import FrpSeccion from "../components/FrpSeccion.astro";
import Layout from "../layouts/Layout.astro";

const makserProducts = [
  {
    title: "FRP Grating",
    description:
      "Rejillas de plástico reforzado con fibra de vidrio, alta resistencia química y a la corrosión.",
    image: "/images/rejilla-frp.jpg", // TODO: placeholder temporal hasta subir foto real a /public/images/
    link: "/rejilla-frp.jpg",
    badge: "Resina Vinilester",
    specifications: [
      "Malla 38x38mm",
      "Espesores 38mm y 25mm",
      "Superficie arenada (Gritted)",
    ],
  },
  {
    title: "Toothed Steel Grating",
    description:
      "Rejilla metálica dentada de alta tracción para tráfico pesado e industrial.",
    image: "/images/rejillametalica.jpg", // TODO: placeholder temporal hasta subir foto real a /public/images/
    link: "/rejillametalica.jpg",
    badge: "Black Iron",
    specifications: [
      "Panel 1000x3000mm",
      "Altura 32mm",
      "Espesor 32mm",
      "Peso unitario 2.5kg/m²",
      "Platina portante 4.75mm",
      "Superficie Dentada",
    ],
  },
  {
    title: "Grapas M Inoxidables",
    description:
      "Clips de fijación tipo M para anclaje seguro de rejillas de fibra de vidrio (FRP).",
    image: "/images/grapa.jpg", // TODO: placeholder temporal hasta subir foto real a /public/images/
    link: "/grapa.jpg",
    badge: "Acero Inox SS 304",
    specifications: [
      "Compatibles con FRP grating de 38mm y 25mm de espesor",
    ],
  },
  {
    title: "Clips Tipo M Galvanizados",
    description:
      "Pernos y grapas de sujeción resistentes a la oxidación para grating metálico.",
    image: "/images/clip-M.png", // TODO: placeholder temporal hasta subir foto real a /public/images/
    link: "/clip-M.png",
    badge: "Galvanizado",
    specifications: [
      "Medida estándar de 1/4 x 2 pulgadas",
    ],
  },
];
const makserAccessories = [
  {
    title: "Grapas M en Acero Inoxidable",
    description: "Grapas tipo M para fijación de FRP grating.",
    link: "#catalogo",
    badge: "SS 304",
    specifications: [
      "Material: Acero Inoxidable SS 304",
      "Uso: Fijación de FRP grating",
    ],
    buttonText: "Consultar accesorio",
  },
  {
    title: "Grapas de Acero Galvanizado",
    description: "Grapas para sujeción de grating metálico dentado.",
    link: "#catalogo",
    badge: "Galvanizado",
    specifications: [
      'Perno de 1/4" x 2"',
      "Uso: Sujeción de grating metálico dentado",
    ],
    buttonText: "Consultar accesorio",
  },
];
---

<Layout
  title="Makser Perú | Soluciones Industriales en Grating, Drenaje y Peldaños FRP"
  description="Fabricación e Importación y distribución directa de Grating Metálico y FRP de alta resistencia anticorrosiva para minería e industria."
>
    <!-- Navbar Global -->
    <Navbar />

    <main class="grow">
      <!-- Sección Hero Principal -->
      <Hero
        title="Soluciones Industriales en Grating Metálico y FRP"
        subtitle="Importación y distribución directa de Grating Metálico, Grating FRP y accesorios de fijación industrial. Stock estandarizado para entrega inmediata."
        ctaText="Cotizar por WhatsApp"
        ctaLink="https://wa.me/51984649227?text=Hola%20Makser,%20deseo%20una%20cotizacion%20de%20productos%20FRP"
        secondaryCtaText="Ver Catálogo FRP"
        secondaryCtaLink="#catalogo"
      />
      <About />

      <FrpSeccion />

      <!-- Sección de Productos / Catálogo -->
      <section id="catalogo">
        <Products
          title="NUESTRO CATÁLOGO DE PRODUCTOS"
          subtitle="Selecciona el producto que necesitas para ver sus especificaciones detalladas y consultar disponibilidad."
          products={makserProducts}
          accessories={makserAccessories}
        />
      </section>

      <Simulator />
    </main>

    <!-- Footer Global -->
    <Footer />
</Layout>
