---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Products from "../components/Products.astro";
import Simulator from "../components/Simulator.astro";
import About from "../components/About.astro";
import FrpSeccion from "../components/FrpSeccion.astro";
import DuchaSeccion from "../components/DuchaSeccion.astro";
import Gallery from "../components/Gallery.astro";
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Layout from "../layouts/Layout.astro";

const maskelProducts = [
  {
    title: "FRP Grating",
    description:
      "Rejillas de plástico reforzado con fibra de vidrio, alta resistencia química y a la corrosión.",
    image: "/images/rejilla-frp.jpg", // TODO: placeholder temporal hasta subir foto real a /public/images/
    link: "/grating-frp",
    badge: "Resina Isoftalica",
    tag: "Producto Principal",
    specifications: [
      "Malla 38x38mm",
      "Espesores 38mm y 25mm",
      "Superficie arenada (Gritted)",
    ],
  },
 {
    title: "Rejillas de Ducha",
    description:
      "Rejillas de ducha lineales tipo Fold Edge, ideales para desagües empotrados en pisos de baños y duchas.",
    image: "/images/rejilladucha.jpg", // TODO: placeholder temporal hasta subir foto real a /public/images/
    link: "/rejilla-ducha",
    badge: "Acero Inoxidable",
    tag: "Producto Principal",
    specifications: [
      "Largo 800mm",
      "Tipo Fold Edge (borde plegado)",
      "6 modelos disponibles",
      "Instalación empotrada en piso",
    ],
  },
 {
    title: "Grapa M Inoxidable",
    description:
      "Clip de fijación tipo M para anclaje seguro de rejillas FRP.",
    image: "/images/grapa.jpg", // TODO: placeholder temporal hasta subir foto real a /public/images/
    link: "/grapa.jpg",
    badge: "Acero Inox SS 304",
    tag: "Accesorio",
    specifications: [
      "Compatible con FRP grating de 38mm de espesor",
      "Compatible con FRP grating de 25mm de espesor",
    ],
  },
];
const maskelAccessories = [
  {
    title: "Grapas M en Acero Inoxidable",
    description: "Grapas tipo M para fijación de FRP grating.",
    link: "#catalogo",
    badge: "SS 304",
    specifications: [
      "Material: Acero Inoxidable SS 304",
      "Uso: Fijación de FRP grating",
    ],
    buttonText: "Consultar accesorio",
  },
  {
    title: "Grapas de Acero Galvanizado",
    description: "Grapas para sujeción de grating metálico dentado.",
    link: "#catalogo",
    badge: "Galvanizado",
    specifications: [
      'Perno de 1/4" x 2"',
      "Uso: Sujeción de grating metálico dentado",
    ],
    buttonText: "Consultar accesorio",
  },
];
---

<Layout
  title="Maskel Perú | Soluciones Industriales en Grating, Drenaje y Peldaños FRP"
  description="Fabricación e Importación y distribución directa de Grating Metálico y FRP de alta resistencia anticorrosiva para minería e industria."
>
    <!-- Navbar Global -->
    <Navbar />

    <main class="grow">
      <!-- Sección Hero Principal -->
      <Hero
        title="GRATING FRP Y REJILLAS DE DUCHA PARA APLICACIONES INDUSTRIALES"
        subtitle="Importación y distribución directa de Grating FRP, rejillas de ducha y clips de fijación. Stock estandarizado para entrega inmediata."
        ctaText="Simular Cotización"
        ctaLink="https://wa.me/51984649227?text=Hola%20Maskel%20Per%C3%BA%2C%20deseo%20una%20cotizaci%C3%B3n%20de%20productos"
        secondaryCtaText="Ver Productos"
        secondaryCtaLink="#productos"
      />
      <About />

      <FrpSeccion />

      <DuchaSeccion />


      <!-- Sección de Productos / Catálogo -->
      <section id="catalogo">
        <Products
          title="NUESTRO CATÁLOGO DE PRODUCTOS"
          subtitle="Selecciona el producto que necesitas para ver sus especificaciones detalladas y consultar disponibilidad."
          products={maskelProducts}
          accessories={maskelAccessories}
        />
      </section>

      <Simulator />

    </main>

    <!-- Footer Global -->
    <Footer />

    <WhatsAppButton message="Hola Maskel Perú, vengo de la página principal y deseo cotizar stock." />
</Layout>
