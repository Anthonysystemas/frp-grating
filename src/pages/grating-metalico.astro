---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import QuoteFormMetalico from '../components/QuoteFormMetalico.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Grating Metálico - Rejillas de Acero Electroforjado | Maskel Perú"
  description="Importación y distribución de rejillas de acero electroforjado y galvanizado en Perú. Alta resistencia estructural para minería e industria."
>
    
    <Navbar />

    <main class="flex-1">
      
      <!-- Galería de Rejillas Metálicas -->
      <Gallery 
        tagline="Galería de producto · Acero Electroforjado"
        titleNormal="REJILLAS"
        titleHighlight="METÁLICAS"
        description="Rejillas de acero electroforjado y galvanizado de alta resistencia para uso industrial, pasarelas y plataformas."
        images={[
          { src: "/images/metalico1.jpg", alt: "Rejilla Metálica Electroforjada", hoverColor: "hover:shadow-blue-500/20" },
          { src: "/images/metalico2.jpg", alt: "Plataforma de Grating Metálico", hoverColor: "hover:shadow-amber-500/20" },
          { src: "/images/metalico3.jpg", alt: "Rejilla Galvanizada Industrial", hoverColor: "hover:shadow-cyan-500/20" },
          { src: "/images/metalico4.jpg", alt: "Detalle Rejilla Metálica", hoverColor: "hover:shadow-blue-500/20" },
        ]}
      />

      <!-- Simulador de Cotización / Selección -->
      <QuoteFormMetalico />

    </main>

    <!-- Botón flotante de WhatsApp dinámico -->
    <WhatsAppButton 
      message="Hola Maskel Perú, deseo una cotización de rejillas Grating Metálico / Acero Electroforjado"
    />

    <Footer />

</Layout>