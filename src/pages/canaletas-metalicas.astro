---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Canaletas Metálicas e Higiénicas | Makser Perú</title>
    <meta name="description" content="Fabricación de canaletas metálicas en acero inoxidable para sectores industriales, cocinas comerciales y uso doméstico. Recolección eficiente de sólidos y máxima higiene." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0A0E1A] text-slate-200 antialiased min-h-screen flex flex-col justify-between">
    
    <!-- Barra de Navegación -->
    <Navbar />

    <!-- Contenido Principal -->
    <main class="pt-28 pb-16 grow">
      
      <!-- BREADCRUMB -->
      <nav class="max-w-7xl mx-auto px-4 text-xs text-slate-400 mb-8">
        <a href="/" class="hover:text-blue-400 transition-colors">← Volver al Inicio</a> 
        <span class="mx-2">/</span> 
        <a href="/#productos" class="hover:text-blue-400 transition-colors">Productos</a> 
        <span class="mx-2">/</span> 
        <span class="text-blue-400 font-semibold">Canaletas Metálicas</span>
      </nav>

      <!-- Hero / Header del Producto -->
      <section class="text-center px-4 max-w-7xl mx-auto mb-12">
        <span class="text-blue-500 text-sm font-semibold tracking-wider uppercase bg-blue-500/10 px-4 py-1.5 rounded-full border border-blue-500/20">
          Fabricación e Higiene
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white mt-4 mb-4 uppercase tracking-tight">
          Canaletas Metálicas Industriales
        </h1>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">
          Diseños higiénicos en acero inoxidable para una evacuación rápida de fluidos y recolección de sólidos. Soluciones a medida para plantas industriales, cocinas comerciales y residencias.
        </p>
      </section>

      <!-- Detalle Técnico y Cotizador Interactivo -->
      <section class="max-w-7xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start mb-16">
        
        <!-- Columna Izquierda: Imagen y Especificaciones por Línea -->
        <div class="flex flex-col gap-8">
          <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-[#0D1220] relative group">
            <img 
              src="/images/canaletas.jpg" 
              alt="Canaleta metálica en acero inoxidable" 
              class="w-full h-[380px] object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute top-4 left-4 bg-blue-600/90 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider backdrop-blur-md">
              Acero Inoxidable AISI 304 / 316
            </div>
          </div>

          <div class="space-y-4">
            <h2 class="text-2xl font-bold text-white uppercase tracking-tight border-b border-slate-800 pb-3">
              Líneas de Fabricación
            </h2>
            
            <ul class="space-y-4 text-slate-300">
              <li class="flex items-start gap-3">
                <span class="text-blue-500 font-bold text-lg">✓</span>
                <div>
                  <strong class="text-white">Línea Industrial:</strong>
                  <p class="text-slate-400 text-sm">Alta resistencia química y mecánica para embotelladoras, pesqueras, minería y plantas de procesamiento alimentario.</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-blue-500 font-bold text-lg">✓</span>
                <div>
                  <strong class="text-white">Línea Cocina Commercial / HORECA:</strong>
                  <p class="text-slate-400 text-sm">Equipadas con canastilla atrapesólidos, acabados sanitarios de fácil limpieza y resistencia a grasas y altas temperaturas.</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-blue-500 font-bold text-lg">✓</span>
                <div>
                  <strong class="text-white">Línea Doméstica / Pluvial:</strong>
                  <p class="text-slate-400 text-sm">Diseño estético y funcional para evacuación de lluvias en techos, patios, cocheras y terrazas.</p>
                </div>
              </li>
            </ul>
          </div>
        </div>

        <!-- Columna Derecha: Configurador Rápido / Formulario a WhatsApp -->
        <div class="bg-[#0D1322] border border-blue-500/20 p-6 sm:p-8 rounded-2xl shadow-xl space-y-6">
          <div>
            <span class="text-blue-400 text-xs font-bold uppercase tracking-wider">Cotizador Express</span>
            <h2 class="text-2xl font-bold text-white mt-1">Configura tu Canaleta</h2>
            <p class="text-xs text-slate-400 mt-1">Ingresa las especificaciones requeridas para enviarte un presupuesto directo a tu WhatsApp.</p>
          </div>

          <form id="canaletas-form" class="space-y-5">
            <!-- Seleccionar Línea/Uso -->
            <div>
              <label for="linea" class="block text-xs font-bold text-slate-300 uppercase mb-2">Línea de Aplicación</label>
              <select id="linea" class="w-full bg-[#0A0E1A] border border-slate-700 rounded-lg p-3 text-sm text-slate-200 focus:border-blue-500 focus:outline-none transition-colors">
                <option value="Industrial">Industrial (Planta de procesos / Química)</option>
                <option value="Cocina Comercial / HORECA">Cocina Comercial (Hoteles / Restaurantes)</option>
                <option value="Doméstica / Pluvial">Doméstica (Drenaje pluvial / Techos)</option>
              </select>
            </div>

            <!-- Calidad de Acero -->
            <div>
              <label for="material" class="block text-xs font-bold text-slate-300 uppercase mb-2">Material / Tipo de Acero</label>
              <select id="material" class="w-full bg-[#0A0E1A] border border-slate-700 rounded-lg p-3 text-sm text-slate-200 focus:border-blue-500 focus:outline-none transition-colors">
                <option value="Acero Inoxidable AISI 304">Acero Inoxidable AISI 304 (Estándar Sanitarios)</option>
                <option value="Acero Inoxidable AISI 316">Acero Inoxidable AISI 316 (Alta resistencia corrosiva)</option>
                <option value="Acero Galvanizado">Acero Galvanizado (Uso Pluvial / Económico)</option>
              </select>
            </div>

            <!-- Accesorios -->
            <div>
              <label for="accesorios" class="block text-xs font-bold text-slate-300 uppercase mb-2">Accesorios Requeridos</label>
              <select id="accesorios" class="w-full bg-[#0A0E1A] border border-slate-700 rounded-lg p-3 text-sm text-slate-200 focus:border-blue-500 focus:outline-none transition-colors">
                <option value="Con Canastilla Atrapesólidos y Rejilla superior">Con Canastilla Atrapesólidos y Rejilla</option>
                <option value="Solo Canaleta sin Rejilla">Solo Canaleta (Sin rejilla superior)</option>
                <option value="Sistema Completo con Salidas de Desagüe">Sistema Completo (Con salidas/trampas)</option>
              </select>
            </div>

            <!-- Metros lineales -->
            <div>
              <label for="cantidad" class="block text-xs font-bold text-slate-300 uppercase mb-2">Metros Lineales Requeridos (Aprox.)</label>
              <input 
                type="number" 
                id="cantidad" 
                min="1" 
                value="5" 
                class="w-full bg-[#0A0E1A] border border-slate-700 rounded-lg p-3 text-sm text-slate-200 focus:border-blue-500 focus:outline-none transition-colors" 
                placeholder="Ej. 6" 
              />
            </div>

            <!-- Botón Enviar a WhatsApp -->
            <button 
              type="button" 
              id="btn-whatsapp-canaleta"
              class="w-full mt-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-4 px-6 rounded-lg transition-all duration-200 text-center text-sm flex items-center justify-center gap-2 shadow-lg shadow-emerald-900/20 cursor-pointer"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 004.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.84 14.13c-.25.7-1.45 1.34-2 1.43-.51.08-1.15.11-1.86-.12a16.7 16.7 0 01-1.69-.62c-2.98-1.29-4.92-4.3-5.07-4.5-.15-.2-1.21-1.61-1.21-3.07 0-1.46.77-2.18 1.04-2.48.27-.3.6-.37.8-.37.2 0 .4 0 .57.01.18.01.43-.07.67.52.25.6.85 2.07.92 2.22.07.15.12.33.02.53-.1.2-.15.32-.3.49-.15.17-.31.38-.45.51-.15.15-.3.31-.13.61.17.3.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.38 1.47.3.15.48.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.27.1 1.73.82 2.03.97.3.15.5.22.57.35.08.13.08.74-.17 1.44z"></path>
              </svg>
              Enviar Cotización por WhatsApp
            </button>
          </form>
        </div>

      </section>

    </main>

    <!-- Botón Flotante de WhatsApp -->
    <WhatsAppButton />

    <!-- Pie de Página -->
    <Footer />

  </body>
</html>

<!-- Script Client-Side para capturar datos y abrir WhatsApp -->
<script>
  const btnWhatsApp = document.getElementById('btn-whatsapp-canaleta');
  
  if (btnWhatsApp) {
    btnWhatsApp.addEventListener('click', () => {
      const linea = (document.getElementById('linea') as HTMLSelectElement).value;
      const material = (document.getElementById('material') as HTMLSelectElement).value;
      const accesorios = (document.getElementById('accesorios') as HTMLSelectElement).value;
      const cantidad = (document.getElementById('cantidad') as HTMLInputElement).value || '1';

      const numeroTelefono = '51984649227';
      
      const mensaje = `Hola *Makser Perú*, solicito cotización para *Canaletas Metálicas* con los siguientes detalles:\n\n` +
                      `🏭 *Línea / Uso:* ${linea}\n` +
                      `🧪 *Material:* ${material}\n` +
                      `🛠️ *Configuración:* ${accesorios}\n` +
                      `📏 *Cantidad aprox.:* ${cantidad} metros\n\n` +
                      `Por favor brindarme costo y tiempo de entrega.`;

      const url = `https://wa.me/${numeroTelefono}?text=${encodeURIComponent(mensaje)}`;
      window.open(url, '_blank');
    });
  }
</script>