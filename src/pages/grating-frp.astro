---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ChatButton from '../components/ChatButton.astro';
import Layout from '../layouts/Layout.astro';
import { productosPorCategoria } from '../data/catalog';

const medidas = productosPorCategoria('frp').map((producto) => {
  const [dimensionCruda, espesorCrudo] = producto.detalle.split('·').map((parte) => parte.trim());
  return {
    dimension: dimensionCruda.replace('x', ' x ').replace('mm', ' mm'),
    espesor: espesorCrudo.replace('Espesor:', '').trim().replace('mm', ' mm'),
  };
});
---

<Layout
  title="Grating FRP | Rejillas de Fibra de Vidrio | Maskel Perú"
  description="Grating FRP anticorrosivo, dieléctrico y antideslizante en medidas de stock para minería, industria y construcción."
>
  <Navbar />

  <main class="bg-[#080C16] pt-20 text-white">
    <section class="border-b border-slate-900/60 bg-[#0D1322] px-6 py-14 sm:py-18">
      <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_420px]">
        <div>
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-blue-400">Stock industrial / fibra de vidrio</p>
          <h1 class="text-3xl font-black uppercase tracking-tight sm:text-5xl">Grating <span class="text-blue-500">FRP</span></h1>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-slate-300 sm:text-base">Rejillas moldeadas de fibra de vidrio para ambientes corrosivos, áreas eléctricas y superficies que requieren alta tracción.</p>
          <button type="button" data-open-cotizador class="mt-7 inline-flex items-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-xs font-black uppercase tracking-wider transition hover:bg-blue-500">Cotizar stock <span aria-hidden="true">→</span></button>
        </div>
        <figure class="overflow-hidden rounded-xl border border-slate-700 bg-[#060913] shadow-2xl">
          <img src="/images/rejilla-frp.jpg" alt="Rejilla Grating FRP de fibra de vidrio" class="h-64 w-full object-cover sm:h-72" />
          <figcaption class="border-t border-slate-800 px-4 py-3 text-xs text-slate-400">Superficie arenada antideslizante · Resina de alta resistencia</figcaption>
        </figure>
      </div>
    </section>

    <section class="px-6 py-16 sm:py-20" aria-labelledby="stock-title">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 max-w-2xl">
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-blue-400">Medidas disponibles</p>
          <h2 id="stock-title" class="text-3xl font-black uppercase tracking-tight sm:text-4xl">Tabla de stock FRP</h2>
          <p class="mt-3 text-slate-400">Estas son las medidas de grating FRP que manejamos. Elige la tuya en el panel de cotización para recibir tu PDF personalizado.</p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-[#0D1220] shadow-xl">
          <table class="w-full min-w-[480px] text-left text-sm">
            <thead class="border-b border-slate-700 bg-[#111827] text-xs uppercase tracking-wider text-slate-300">
              <tr><th class="px-5 py-4">Dimensión</th><th class="px-5 py-4">Espesor</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              {medidas.map((medida) => (
                <tr class="transition hover:bg-blue-500/5">
                  <td class="px-5 py-4 font-semibold text-white">{medida.dimension}</td>
                  <td class="px-5 py-4 text-slate-300">H {medida.espesor}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="px-6 pb-16 sm:pb-20" aria-labelledby="specs-title">
      <div class="mx-auto max-w-6xl">
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-blue-400">Ficha del material</p>
        <h2 id="specs-title" class="text-3xl font-black uppercase tracking-tight sm:text-4xl">Especificaciones técnicas</h2>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-xl border border-slate-800 bg-[#0D1220] p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-blue-400">Resina</p>
            <p class="mt-2 text-sm text-slate-200">Resina isoftálica de alta resistencia química</p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-[#0D1220] p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-blue-400">Resistencia a la carga</p>
            <p class="mt-2 text-sm text-slate-200">Alta resistencia estructural para tránsito peatonal y vehicular liviano</p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-[#0D1220] p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-blue-400">Área abierta</p>
            <p class="mt-2 text-sm text-slate-200">Amplio porcentaje de área abierta para buen drenaje y ventilación</p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-[#0D1220] p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-blue-400">Color</p>
            <p class="mt-2 text-sm text-slate-200">Amarillo de seguridad</p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-[#0D1220] p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-blue-400">Superficie</p>
            <p class="mt-2 text-sm text-slate-200">Arenada antideslizante</p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-slate-900/60 bg-[#0D1322] px-6 py-16" aria-labelledby="frp-benefits-title">
      <div class="mx-auto max-w-6xl">
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-blue-400">Ventajas del material</p>
        <h2 id="frp-benefits-title" class="text-3xl font-black uppercase tracking-tight sm:text-4xl">Checklist FRP</h2>
        <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {['100% anticorrosivo', 'Dieléctrico / aislante', 'Superficie antideslizante', 'Bajo peso estructural', 'Fácil instalación', 'Stock disponible'].map((beneficio) => (
            <div class="flex items-center gap-3 rounded-lg border border-slate-800 bg-[#0A0E1A] p-4 text-sm text-slate-200"><span class="font-bold text-blue-400">✓</span>{beneficio}</div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <ChatButton />
  <Footer />
</Layout>
