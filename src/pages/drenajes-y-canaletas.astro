---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rejillas de Drenaje y Canaletas | Makser Perú</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#0A0E1A] text-slate-200 antialiased min-h-screen flex flex-col justify-between">
    
    <!-- Barra de Navegación -->
    <Navbar />

    <!-- Contenido Principal -->
    <main class="pt-28 pb-16 grow">
      
      <!-- Hero / Header del Producto -->
      <section class="text-center px-4 max-w-7xl mx-auto mb-12">
        <span class="text-blue-500 text-sm font-semibold tracking-wider uppercase bg-blue-500/10 px-4 py-1.5 rounded-full border border-blue-500/20">
          Fabricación e Importación Directa
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white mt-4 mb-4">
          Rejillas de Drenaje y Canaletas
        </h1>
        <p class="text-slate-400 text-lg max-w-2xl mx-auto">
          Soluciones industriales en Acero Galvanizado y FRP diseñadas para la evacuación fluida de líquidos y resistencia a cargas pesadas.
        </p>
      </section>

      <!-- Detalle Técnico y Cotización -->
      <section class="max-w-7xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Imagen -->
        <div class="rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-[#0D1220]">
          <img 
            src="/images/drenaje.jpg" 
            alt="Rejilla de drenaje industrial" 
            class="w-full h-96 object-cover"
          />
        </div>

        <!-- Información -->
        <div class="flex flex-col gap-6">
          <h2 class="text-2xl font-bold text-white">Especificaciones Principales</h2>
          <ul class="space-y-4 text-slate-300">
            <li class="flex items-start gap-3">
              <span class="text-blue-500 font-bold text-lg">✓</span>
              <div>
                <strong>Materiales disponibles:</strong>
                <p class="text-slate-400 text-sm">Acero Galvanizado en Caliente (ASTM A36 / NAAMM) y Fibra de Vidrio (FRP).</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-blue-500 font-bold text-lg">✓</span>
              <div>
                <strong>Aplicaciones clave:</strong>
                <p class="text-slate-400 text-sm">Canaletas pluviales, plantas de procesamiento, minería y pasos peatonales o de tránsito pesado.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-blue-500 font-bold text-lg">✓</span>
              <div>
                <strong>Propiedades destacadas:</strong>
                <p class="text-slate-400 text-sm">Alta resistencia a ambientes corrosivos, diseño antideslizante y máxima capacidad de flujo.</p>
              </div>
            </li>
          </ul>

          <!-- Botones de Acción -->
          <div class="pt-4 flex flex-col sm:flex-row gap-4">
            <a 
              href="/#simulator" 
              class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-3.5 px-6 rounded-lg transition-colors text-center text-sm"
            >
              Cotizar en Simulador
            </a>
            <a 
              href="https://wa.me/51984649227?text=Hola,%20requiero%20información%20sobre%20Rejillas%20de%20Drenaje" 
              target="_blank" 
              rel="noopener noreferrer"
              class="border-2 border-green-500/60 hover:border-green-500 hover:bg-green-500/10 text-green-400 font-bold py-3.5 px-6 rounded-lg transition-all duration-200 text-center text-sm flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 004.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.84 14.13c-.25.7-1.45 1.34-2 1.43-.51.08-1.15.11-1.86-.12a16.7 16.7 0 01-1.69-.62c-2.98-1.29-4.92-4.3-5.07-4.5-.15-.2-1.21-1.61-1.21-3.07 0-1.46.77-2.18 1.04-2.48.27-.3.6-.37.8-.37.2 0 .4 0 .57.01.18.01.43-.07.67.52.25.6.85 2.07.92 2.22.07.15.12.33.02.53-.1.2-.15.32-.3.49-.15.17-.31.38-.45.51-.15.15-.3.31-.13.61.17.3.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.38 1.47.3.15.48.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.27.1 1.73.82 2.03.97.3.15.5.22.57.35.08.13.08.74-.17 1.44z"></path>
              </svg>
              Contactar por WhatsApp
            </a>
          </div>
        </div>
      </section>

    </main>
     <WhatsAppButton />
    <!-- Pie de Página -->
    <Footer />
  </body>
</html>